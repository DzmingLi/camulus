;;; mail-demo.el --- Temporary reader for the OCaml mail backend -*- lexical-binding: t; -*-
(require 'effects-probe)
(require 'tabulated-list)
(require 'json)
(require 'subr-x)
(require 'shr)
(defvar ef-mail-root (expand-file-name "~/Maildir"))
(defvar ef-mail-muhome (expand-file-name "~/.cache/mu"))
(defvar ef-mail-sender nil)
(defvar ef-mail-smtp-profiles nil "Lists of profile, host, port, username, password-file, CA-file.")
(defvar ef-mail-account "")
(defvar ef-mail-accounts nil "Account routes: (MAILDIR-PREFIX SENDER MSMTP-ACCOUNT).")
(defvar ef-mail--requests (make-hash-table :test #'eql))
(defvar ef-mail--downloads (make-hash-table :test #'eql))
(defvar-local ef-mail--group nil)
(defvar-local ef-mail--query nil)
(defvar-local ef-mail--after nil)
(defvar-local ef-mail--messages nil)
(defvar-local ef-mail--attachments nil)
(defvar-local ef-mail--active nil)
(defvar-local ef-mail--complete nil)

(defun ef-mail-start ()
  (when (equal (ef-probe-status) "idle")
    (setq ef-mail-sender (or ef-mail-sender (read-string "Sending address: " user-mail-address)))
    (ef-mail-configure ef-mail-root ef-mail-muhome ef-mail-sender
                       (or (executable-find "mu") "mu")
                       ef-mail-account)
    (dolist (profile ef-mail-smtp-profiles) (apply #'ef-mail-configure-smtp profile))
    (dolist (account ef-mail-accounts) (apply #'ef-mail-configure-account account))
    (clrhash ef-mail--requests)
    (ef-probe-session-start)))

(defun ef-mail--request (request buffer)
  (let ((id (camulus-mail-submit request)))
    (puthash id buffer ef-mail--requests)
    (with-current-buffer buffer (setq ef-mail--active id))
    id))

(defun ef-mail--event (event)
  (let* ((id (nth 1 event)) (buffer (gethash id ef-mail--requests)))
    (when (gethash id ef-mail--downloads)
      (pcase (car event)
        ('mail
         (let ((data (nth 3 event)))
           (when (equal (alist-get 'kind data) "saved")
             (message "Attachment saved: %s" (alist-get 'path data)))))
        ('finished
         (unless (eq (nth 3 event) 'completed)
           (message "Attachment save %s: %s" (nth 3 event) (nth 4 event)))
         (remhash id ef-mail--downloads))))
    (when (buffer-live-p buffer)
      (with-current-buffer buffer
        (when (eql id ef-mail--active)
          (pcase (car event)
            ('mail
             (let ((data (nth 3 event)))
               (pcase (alist-get 'kind data)
                 ("page"
                  (dolist (m (alist-get 'messages data)) (puthash (alist-get 'id m) m ef-mail--messages))
                  (setq ef-mail--after (alist-get 'after data))
                  (ef-mail--render-summary)
                  (when (alist-get 'truncated data) (message "Mail result limit reached; narrow the search")))
                 ("thread"
                  (dolist (m (alist-get 'messages data)) (puthash (alist-get 'id m) m ef-mail--messages))
                  (setq ef-mail--complete (alist-get 'complete data))
                  (ef-mail--render-thread))
                 ("article"
                  (let ((m (alist-get 'message data)))
                    (puthash (alist-get 'id m) m ef-mail--messages)
                    (puthash (alist-get 'id m) (alist-get 'attachments data) ef-mail--attachments))
                  (ef-mail--render-thread)))))
            ('finished
             (when (eq (nth 3 event) 'failed)
               (message "Mail: %s" (nth 4 event))))))))
    (when (eq (car event) 'finished) (remhash id ef-mail--requests))))
(add-hook 'ef-probe-event-hook #'ef-mail--event)

(define-derived-mode ef-mail-summary-mode tabulated-list-mode "Mail"
  (setq tabulated-list-format [("From" 28 t) ("Subject" 80 t)]
        header-line-format "RET: thread   c: compose   r: reply   a: archive thread   G: drafts   g: refresh   s: search   n: next")
  (tabulated-list-init-header))
(define-key ef-mail-summary-mode-map (kbd "RET") #'ef-mail-open-thread)
(define-key ef-mail-summary-mode-map (kbd "g") #'ef-mail-refresh)
(define-key ef-mail-summary-mode-map (kbd "s") #'ef-mail-search)
(define-key ef-mail-summary-mode-map (kbd "n") #'ef-mail-next-page)
(defun ef-mail--render-summary ()
  (setq tabulated-list-entries
        (mapcar (lambda (m) (list (alist-get 'id m) (vector (alist-get 'author m) (alist-get 'title m))))
                (sort (hash-table-values ef-mail--messages)
                      (lambda (a b) (> (alist-get 'created a) (alist-get 'created b))))))
  (tabulated-list-print t))
(defun ef-mail--load (after)
  (when ef-mail--active (ef-probe-cancel ef-mail--active))
  (ef-mail--request `((op . ,(if ef-mail--query "search" "list")) (group . ,ef-mail--group)
                     (query . ,ef-mail--query) (after . ,after)) (current-buffer)))
(defun ef-mail-refresh ()
  (interactive)
  (setq ef-mail--messages (make-hash-table :test #'equal) ef-mail--after nil)
  (ef-mail--load nil))
(defun ef-mail-search (query)
  (interactive "sSearch this Maildir (empty resets): ")
  (setq ef-mail--query (unless (string-empty-p query) query)) (ef-mail-refresh))
(defun ef-mail-next-page ()
  (interactive)
  (if ef-mail--after (ef-mail--load ef-mail--after) (message "No further page")))
(defun ef-mail-browse (group)
  "Browse a local mu Maildir; backend policy lives in OCaml."
  (interactive "sMaildir group (e.g. /dzming-li/Inbox): ")
  (ef-mail-start)
  (pop-to-buffer (get-buffer-create (format "*Mail %s*" group)))
  (ef-mail-summary-mode)
  (setq ef-mail--group group)
  (ef-mail-refresh))

(define-derived-mode ef-mail-thread-mode special-mode "Mail thread"
  (when (fboundp 'olivetti-mode) (olivetti-mode 1))
  (add-hook 'kill-buffer-hook
            (lambda () (when (and ef-mail--active (not (equal (ef-probe-status) "idle")))
                         (ef-probe-cancel ef-mail--active))) nil t))
(defun ef-mail--anchor (position)
  (when-let* ((id (get-text-property position 'ef-mail-id))
              (start (or (previous-single-property-change (1+ position) 'ef-mail-id) (point-min))))
    (cons id (- position start))))
(defun ef-mail--position (anchor)
  (when anchor
    (let ((p (point-min)) found)
      (while (and (< p (point-max)) (not found))
        (if (equal (get-text-property p 'ef-mail-id) (car anchor)) (setq found p)
          (setq p (next-single-property-change p 'ef-mail-id nil (point-max)))))
      (when found
        (min (1- (next-single-property-change found 'ef-mail-id nil (point-max)))
             (+ found (cdr anchor)))))))
(defun ef-mail--save-button (button)
  (let ((destination (read-file-name "Save attachment to: " nil nil nil
                                     (file-name-nondirectory (button-get button 'filename)))))
    (puthash (camulus-mail-submit `((op . "attachment") (id . ,(button-get button 'message-id))
                                           (part . ,(button-get button 'part)) (destination . ,destination)))
             t ef-mail--downloads)
    (message "Attachment save requested")))
(defun ef-mail--render-thread ()
  (let ((inhibit-read-only t) (anchor (ef-mail--anchor (point)))
        (windows (mapcar (lambda (w) (cons w (ef-mail--anchor (window-start w))))
                         (get-buffer-window-list (current-buffer) nil t)))
        (messages (sort (hash-table-values ef-mail--messages)
                        (lambda (a b) (< (alist-get 'created a) (alist-get 'created b)))))
        (seen (make-hash-table :test #'equal)))
    (erase-buffer)
    (cl-labels ((render (m depth)
                 (let ((id (alist-get 'id m)))
                   (unless (gethash id seen)
                     (puthash id t seen)
                     (let ((start (point)))
                       (insert (make-string (* 2 (min depth 12)) ?\s) (alist-get 'author m) "\n"
                               (alist-get 'title m) "\n\n")
                       (if (and (string-empty-p (alist-get 'body m)) (alist-get 'html m))
                           (let ((shr-inhibit-images t))
                             (shr-insert-document (with-temp-buffer (insert (alist-get 'html m))
                                                    (libxml-parse-html-region (point-min) (point-max)))))
                         (insert (alist-get 'body m)))
                       (insert "\n")
                       (dolist (a (gethash id ef-mail--attachments))
                         (insert-text-button (format "[Save %s · %d bytes]" (alist-get 'name a) (alist-get 'size a))
                                             'action #'ef-mail--save-button 'follow-link t
                                             'message-id id 'part (alist-get 'part a) 'filename (alist-get 'name a))
                         (insert "\n"))
                       (insert "\n")
                       (add-text-properties start (point) `(ef-mail-id ,id)))
                     (dolist (child messages)
                       (when (equal (alist-get 'parent_id child) id) (render child (1+ depth))))))))
      (dolist (m messages) (unless (gethash (alist-get 'parent_id m) ef-mail--messages) (render m 0)))
      (dolist (m messages) (render m 0)))
    (setq header-line-format (format "%d messages — %s — r: reply   a: archive message   c: compose   G: drafts"
                                    (hash-table-count ef-mail--messages) (if ef-mail--complete "loaded" "loading / partial")))
    (goto-char (or (ef-mail--position anchor) (point-min)))
    (dolist (w windows) (when-let* ((p (ef-mail--position (cdr w)))) (set-window-start (car w) p t)))))
(defun ef-mail-open-thread ()
  (interactive)
  (let ((id (tabulated-list-get-id)) (buffer (get-buffer-create "*Mail thread*"))
        (group ef-mail--group) (summary-window (selected-window)))
    (unless id (user-error "Select a message first"))
    (with-current-buffer buffer
      (when ef-mail--active (ef-probe-cancel ef-mail--active))
      (ef-mail-thread-mode)
      (setq ef-mail--group group ef-mail--summary-window summary-window)
      (setq ef-mail--messages (make-hash-table :test #'equal)
            ef-mail--attachments (make-hash-table :test #'equal) ef-mail--complete nil)
      (ef-mail--request `((op . "thread") (id . ,id)) buffer))
    (display-buffer-in-direction buffer '((direction . right) (window-width . 0.6)))))
(require 'mail-workflow)
(ef-mail-bind-demo-keys)
(provide 'mail-demo)
