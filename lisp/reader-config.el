;;; reader-config.el --- Declarative browsing entries -*- lexical-binding: t; -*-
(require 'json)
(require 'cl-lib)
(require 'subr-x)
(defun ef-reader--data-path (root name)
  "Return a Camulus data path."
  (expand-file-name (concat "camulus/" name) root))
(defvar ef-reader-config-file
  (ef-reader--data-path (or (getenv "XDG_CONFIG_HOME") (expand-file-name "~/.config")) "entries.json"))
(defvar ef-reader-rss-subscriptions-file
  (ef-reader--data-path (or (getenv "XDG_CONFIG_HOME") (expand-file-name "~/.config")) "rss-subscriptions.json"))
(defvar camulus-jsonfeed-subscriptions-file
  (expand-file-name "camulus/jsonfeed-subscriptions.json"
                    (or (getenv "XDG_CONFIG_HOME") (expand-file-name "~/.config"))))
(defvar ef-reader-entries nil "Configured backend entries; declaring one never subscribes to it.")
(defvar ef-reader-home nil "Legacy default entry; the home screen is now the unified timeline.")
(defvar ef-discourse-sites)
(defun ef-reader--backend-settings (settings)
  "Validate backend settings and return variable assignments without applying them."
  (let (assignments)
    (dolist (spec '((csrin site camulus-csrin-site string)
                    (browser firefox_profile ef-reader-firefox-profile string)
                    (discourse auth_sources ef-discourse-auth-sources strings)
                    (reddit username ef-reddit-username string)
                    (reddit token_file ef-reddit-token-file string)
                    (maildir root ef-mail-root string)
                    (maildir muhome ef-mail-muhome string)
                    (maildir sender ef-mail-sender string)
                    (maildir account ef-mail-account string)
                    (maildir accounts ef-mail-accounts accounts)
                    (maildir smtp_profiles ef-mail-smtp-profiles smtp)))
      (pcase-let ((`(,backend ,key ,variable ,kind) spec))
        (when-let* ((pair (assq key (alist-get backend settings))))
          (let ((value (cdr pair)))
            (unless
                (pcase kind
                  ('string (and (stringp value) (not (string-match-p "\0" value))))
                  ('strings (and (listp value) (cl-every #'stringp value)))
                  ('accounts (and (listp value)
                                  (cl-every (lambda (row) (and (listp row) (= (length row) 3)
                                                              (cl-every #'stringp row))) value)))
                  ('smtp (and (listp value)
                              (cl-every (lambda (row)
                                          (and (listp row) (= (length row) 6)
                                               (integerp (nth 2 row)) (< 0 (nth 2 row) 65536)
                                               (cl-every #'stringp (append (cl-subseq row 0 2) (nthcdr 3 row))))) value))))
              (user-error "Invalid backend setting: %s.%s" backend key))
            (push (cons variable value) assignments)))))
    assignments))
(defun ef-reader-load-config ()
  "Read JSON data only. An invalid file leaves the previous configuration intact."
  (when (file-exists-p ef-reader-config-file)
    (let* ((data (with-temp-buffer
                   (insert-file-contents ef-reader-config-file)
                   (json-parse-buffer :object-type 'alist :array-type 'list
                                      :null-object nil :false-object :json-false)))
           (entries (alist-get 'entries data)) (home (alist-get 'home data)) (names nil)
           (settings (ef-reader--backend-settings (alist-get 'backend_settings data))))
      (unless (and (equal (alist-get 'version data) 1)
                   (assq 'entries data) (listp entries)
                   (or (null home) (stringp home)))
        (user-error "Invalid reader configuration: expected version 1, entries and optional home"))
      (dolist (entry entries)
        (when (and (assq 'timeline entry) (not (memq (alist-get 'timeline entry) '(t :json-false))))
          (user-error "Entry timeline must be true or false"))
        (dolist (key '(name source group))
          (unless (and (stringp (alist-get key entry))
                       (not (string-empty-p (alist-get key entry)))
                       (not (string-match-p "\0" (alist-get key entry))))
            (user-error "Each entry needs nonempty name, source and group strings")))
        (when (member (alist-get 'name entry) names) (user-error "Duplicate entry name"))
        (push (alist-get 'name entry) names)
        (when (string-prefix-p "discourse:" (alist-get 'source entry))
          (setf (alist-get 'source entry)
                (concat "discourse:" (ef-discourse-site (substring (alist-get 'source entry) 10))))))
      (when (and home (not (member home names))) (user-error "Home must name a configured entry"))
      (setq ef-reader-entries entries ef-reader-home home)
      (dolist (assignment settings) (set (car assignment) (cdr assignment)))))
  (dolist (entry ef-reader-entries)
    (let ((source (alist-get 'source entry)))
      (when (string-prefix-p "discourse:" source)
        (cl-pushnew (substring source 10) ef-discourse-sites :test #'equal)))))
(defun ef-reader-edit-config ()
  "Edit the entry configuration. No remote state is changed by saving this file."
  (interactive)
  (make-directory (file-name-directory ef-reader-config-file) t)
  (find-file ef-reader-config-file)
  (when (= (buffer-size) 0)
    (insert "{\n  \"version\": 1,\n  \"home\": null,\n  \"entries\": []\n}\n"))
  (message "Save entries with name, source and group; G reloads the entry picker. New credentials need a runtime restart."))

(provide 'reader-config)
