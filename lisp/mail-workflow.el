;;; mail-workflow.el --- Draft and archive UI adapter -*- lexical-binding: t; -*-
(require 'message)
(defvar-local ef-mail--group nil)
(defvar-local ef-mail--messages nil)
(defvar ef-mail--actions (make-hash-table :test #'eql))
(defvar ef-mail-autosave-delay 0.75)
(defvar-local ef-mail--summary-window nil)
(defvar-local ef-mail-draft-key nil)
(defvar-local ef-mail-draft-revision nil)
(defvar-local ef-mail-draft-timer nil)
(defvar-local ef-mail-draft-saving nil)
(defvar-local ef-mail-draft-error nil)
(defvar-local ef-mail-draft-sending nil)

(defun ef-mail--action (data receive &optional finish)
  (let ((id (camulus-mail-submit data)))
    (puthash id (cons receive finish) ef-mail--actions) id))
(defun ef-mail--action-event (event)
  (when-let* ((callbacks (gethash (nth 1 event) ef-mail--actions)))
    (pcase (car event)
      ('mail (funcall (car callbacks)
                      (nth 3 event)))
      ('finished
       (remhash (nth 1 event) ef-mail--actions)
       (if (cdr callbacks) (funcall (cdr callbacks) (nth 3 event) (nth 4 event))
         (unless (eq (nth 3 event) 'completed) (message "Mail: %s" (nth 4 event))))))))
(add-hook 'ef-probe-event-hook #'ef-mail--action-event)

(defun ef-mail--editor-window ()
  (if (and (derived-mode-p 'ef-mail-thread-mode) (window-live-p ef-mail--summary-window))
      ef-mail--summary-window (selected-window)))
(defun ef-mail--selected-id ()
  (if (derived-mode-p 'ef-mail-thread-mode) (get-text-property (point) 'ef-mail-id)
    (tabulated-list-get-id)))

(defun ef-mail--open-composer (data window)
  (let* ((key (alist-get 'key data))
         (existing (cl-find-if (lambda (b) (with-current-buffer b (equal ef-mail-draft-key key))) (buffer-list)))
         (buffer (or existing (generate-new-buffer "*Mail draft*"))))
    (unless existing
      (with-current-buffer buffer
        (message-mode)
        (insert (replace-regexp-in-string "\r\n" "\n" (alist-get 'source data) t t))
        (goto-char (point-min))
        (when (search-forward "\n\n" nil t)
          (replace-match (concat "\n" mail-header-separator "\n") t t))
        (setq ef-mail-draft-key key ef-mail-draft-revision (alist-get 'revision data)
              ef-mail--group (alist-get 'group data)
              header-line-format "Draft — autosave   C-c C-s: save   C-c C-c: send   C-c C-k: save and close")
        (use-local-map (copy-keymap message-mode-map))
        (local-set-key (kbd "C-x C-s") #'ef-mail-save-draft)
        (local-set-key (kbd "C-c C-s") #'ef-mail-save-draft)
        (local-set-key (kbd "C-c C-c") #'ef-mail-send-draft)
        (local-set-key (kbd "C-c C-k") #'ef-mail-close-draft)
        ;; Prevent standard Message commands from bypassing the native backend.
        (setq-local message-send-mail-function #'ef-mail--no-direct-send)
        (add-hook 'after-change-functions #'ef-mail--draft-changed nil t)
        (add-hook 'kill-buffer-query-functions #'ef-mail--draft-before-kill nil t)
        (add-hook 'kill-buffer-hook #'ef-mail--draft-cancel-timer nil t)
        (set-buffer-modified-p nil)
        (message-goto-body)))
    (if (window-live-p window) (progn (set-window-buffer window buffer) (select-window window))
      (pop-to-buffer buffer))))
(defun ef-mail--no-direct-send () (user-error "Use C-c C-c to send through the OCaml mail backend"))

(defun ef-mail-compose (&optional reply)
  (interactive)
  (let ((window (ef-mail--editor-window)) (group ef-mail--group)
        (id (and reply (ef-mail--selected-id))))
    (unless group (user-error "Open a mail group first"))
    (when (and reply (not id)) (user-error "Select a message to reply to"))
    (ef-mail--action `((op . "draft-new") (group . ,group) (reply_to . ,id))
                     (lambda (data) (ef-mail--open-composer (alist-get 'draft data) window)))))
(defun ef-mail-reply () (interactive) (ef-mail-compose t))

(defun ef-mail--draft-source ()
  (let ((source (buffer-substring-no-properties (point-min) (point-max))))
    (if (string-match (concat "^" (regexp-quote mail-header-separator) "$") source)
        (concat (substring source 0 (match-beginning 0)) (substring source (match-end 0)))
      source)))
(defun ef-mail--draft-cancel-timer ()
  (when (timerp ef-mail-draft-timer) (cancel-timer ef-mail-draft-timer))
  (setq ef-mail-draft-timer nil))
(defun ef-mail--draft-changed (&rest _)
  (ef-mail--draft-cancel-timer)
  (let ((buffer (current-buffer)))
    (setq ef-mail-draft-timer
          (run-at-time ef-mail-autosave-delay nil
                       (lambda ()
                         (when (buffer-live-p buffer)
                           (with-current-buffer buffer
                             (unless (or ef-mail-draft-error ef-mail-draft-sending)
                               (ef-mail-save-draft)))))))))
(defun ef-mail-save-draft ()
  (interactive)
  (when (called-interactively-p 'interactive) (setq ef-mail-draft-error nil))
  (ef-mail--draft-cancel-timer)
  (when (and ef-mail-draft-key (buffer-modified-p) (not ef-mail-draft-saving) (not ef-mail-draft-sending))
    (let ((buffer (current-buffer)) (tick (buffer-chars-modified-tick)))
      (setq ef-mail-draft-saving t)
      (condition-case err
          (ef-mail--action
           `((op . "draft-save") (key . ,ef-mail-draft-key) (revision . ,ef-mail-draft-revision)
             (source . ,(ef-mail--draft-source)))
           (lambda (data)
             (when (buffer-live-p buffer)
               (with-current-buffer buffer
                 (let ((draft (alist-get 'draft data)))
                   (setq ef-mail-draft-revision (alist-get 'revision draft) ef-mail-draft-error nil)
                   (when (= tick (buffer-chars-modified-tick)) (set-buffer-modified-p nil))
                   (unless (alist-get 'indexed draft) (message "Draft saved; mu index update pending"))))))
           (lambda (state reason)
             (when (buffer-live-p buffer)
               (with-current-buffer buffer
                 (setq ef-mail-draft-saving nil)
                 (if (eq state 'completed)
                     (when (buffer-modified-p) (ef-mail--draft-changed))
                   (setq ef-mail-draft-error reason)
                   (message "Draft not saved: %s" reason))))))
        (error (setq ef-mail-draft-saving nil ef-mail-draft-error (error-message-string err))
               (message "Draft not saved: %s" ef-mail-draft-error))))))
(defun ef-mail--draft-flush ()
  (when ef-mail-draft-error (user-error "%s" ef-mail-draft-error))
  (ef-mail-save-draft)
  (ef-probe-await (lambda () (or ef-mail-draft-error (and (not ef-mail-draft-saving) (not (buffer-modified-p))))) 15)
  (when ef-mail-draft-error (user-error "%s" ef-mail-draft-error)))
(defun ef-mail--draft-before-kill ()
  (condition-case err
      (progn (when ef-mail-draft-sending (user-error "Wait for the send result before closing"))
             (ef-mail--draft-flush) t)
    (error (message "Keeping unsaved draft open: %s" (error-message-string err)) nil)))
(defun ef-mail-close-draft () (interactive) (when (ef-mail--draft-before-kill) (kill-buffer)))
(defun ef-mail-send-draft ()
  "Explicitly submit this saved draft through its OCaml account backend."
  (interactive)
  (when ef-mail-draft-sending (user-error "Sending is already in progress"))
  (ef-mail--draft-flush)
  (let ((buffer (current-buffer)))
    (setq ef-mail-draft-sending t buffer-read-only t)
    (condition-case err
        (ef-mail--action
         `((op . "draft-send") (key . ,ef-mail-draft-key) (revision . ,ef-mail-draft-revision))
         (lambda (data)
           (when (buffer-live-p buffer)
             (with-current-buffer buffer
               (setq ef-mail-draft-sending nil ef-mail-draft-key nil)
               (set-buffer-modified-p nil)
               (if (alist-get 'cleaned data)
                   (progn (message "Mail sent; copy saved in Sent") (kill-buffer buffer))
                 (setq header-line-format "Mail sent — local cleanup incomplete; do not resend")
                 (message "Mail sent; local cleanup incomplete. Do not resend.")))))
         (lambda (state reason)
           (when (and (buffer-live-p buffer) (not (eq state 'completed)))
             (with-current-buffer buffer
               (setq ef-mail-draft-sending nil buffer-read-only nil)
               (message "Mail send: %s" reason)))))
      (error (setq ef-mail-draft-sending nil buffer-read-only nil) (signal (car err) (cdr err))))))
(defun ef-mail--flush-all-drafts ()
  (dolist (buffer (buffer-list))
    (with-current-buffer buffer (when ef-mail-draft-key (ef-mail--draft-flush)))))
(add-hook 'kill-emacs-hook #'ef-mail--flush-all-drafts)

(define-derived-mode ef-mail-drafts-mode tabulated-list-mode "Mail drafts"
  (setq tabulated-list-format [("Subject" 60 t)] header-line-format "RET: resume draft   g: refresh   c: compose")
  (tabulated-list-init-header))
(defun ef-mail-drafts ()
  (interactive)
  (let ((group ef-mail--group))
    (unless group (user-error "Open a mail group first"))
    (switch-to-buffer (get-buffer-create (format "*Mail drafts %s*" group)))
    (ef-mail-drafts-mode) (setq ef-mail--group group) (ef-mail-drafts-refresh)))
(defun ef-mail-drafts-refresh ()
  (interactive)
  (let ((buffer (current-buffer)))
    (ef-mail--action `((op . "draft-list") (group . ,ef-mail--group))
      (lambda (data)
        (when (buffer-live-p buffer)
          (with-current-buffer buffer
            (setq tabulated-list-entries
                  (mapcar (lambda (d) (list (alist-get 'key d) (vector (or (alist-get 'subject d) ""))))
                          (alist-get 'drafts data)))
            (tabulated-list-print t)))))))
(defun ef-mail-resume-draft ()
  (interactive)
  (let ((key (tabulated-list-get-id)) (window (selected-window)))
    (unless key (user-error "Select a draft"))
    (ef-mail--action `((op . "draft-open") (key . ,key))
      (lambda (data) (ef-mail--open-composer (alist-get 'draft data) window)))))

(defun ef-mail-archive ()
  (interactive)
  (let ((id (ef-mail--selected-id)) (group ef-mail--group) (buffer (current-buffer))
        (whole (derived-mode-p 'ef-mail-summary-mode)))
    (unless (and id group) (user-error "Select mail to archive"))
    (ef-mail--action `((op . "archive") (group . ,group) (id . ,id) (thread . ,(if whole t :json-false)))
      (lambda (data)
        (message "Archived %d messages to %s; %d failed"
                 (length (alist-get 'moved data)) (alist-get 'destination data) (alist-get 'failed data))
        (when (buffer-live-p buffer)
          (with-current-buffer buffer (when (derived-mode-p 'ef-mail-summary-mode) (ef-mail-refresh))))))))

(defun ef-mail-bind-demo-keys ()
  (when (and (boundp 'ef-mail-summary-mode-map) (boundp 'ef-mail-thread-mode-map))
(dolist (map (list ef-mail-summary-mode-map ef-mail-thread-mode-map))
  (define-key map (kbd "c") #'ef-mail-compose)
  (define-key map (kbd "r") #'ef-mail-reply)
  (define-key map (kbd "a") #'ef-mail-archive)
  (define-key map (kbd "G") #'ef-mail-drafts))
))
(ef-mail-bind-demo-keys)
(define-key ef-mail-drafts-mode-map (kbd "RET") #'ef-mail-resume-draft)
(define-key ef-mail-drafts-mode-map (kbd "g") #'ef-mail-drafts-refresh)
(define-key ef-mail-drafts-mode-map (kbd "c") #'ef-mail-compose)
(provide 'mail-workflow)
