;;; camulus.el --- Configuration and startup for the native Ecaml reader -*- lexical-binding: t; -*-
(require 'camulus-runtime)
(require 'tabulated-list)
(require 'json)
(require 'shr)
(require 'subr-x)
(require 'button)
(require 'discourse-reader)
(require 'reader-config)
(require 'mail-workflow)

(defvar ef-reader-firefox-profile nil)

(defvar ef-reader-state-file
  (ef-reader--data-path (or (getenv "XDG_STATE_HOME") (expand-file-name "~/.local/state")) "state.sqlite3"))
(defvar ef-reader--requests (make-hash-table :test #'eql))
(defvar ef-reader--completions (make-hash-table :test #'eql))
(defvar ef-reader--loads (make-hash-table :test #'eql))
(defvar ef-reader--states (make-hash-table :test #'equal))
(defvar ef-reader--reading (make-hash-table :test #'equal))
(defvar-local ef-reader--entry nil)
(defvar-local ef-reader--home nil)
(defvar-local ef-reader--cursor nil)
(defvar-local ef-reader--query nil)
(defvar-local ef-reader--search-rows nil)
(defvar-local ef-reader--list-token nil)
(defvar-local ef-reader--list-request nil)
(defvar-local ef-reader--rows nil)
(defvar-local ef-reader--folder nil)
(defvar-local ef-reader--source nil)
(defvar-local ef-reader--title nil)
(defvar-local ef-reader--messages nil)
(defvar-local ef-reader--attachments nil)
(defvar-local ef-reader--loaded nil)
(defvar-local ef-reader--complete nil)
(defvar-local ef-reader--archive nil)
(defvar-local ef-reader--active nil)
(defvar-local ef-reader--positioned nil)
(defvar-local ef-reader--view-token nil)
(defvar-local ef-reader--visibility-timer nil)

(defun ef-reader-start ()
  (when (equal (ef-probe-status) "idle")
    (ef-reader-load-config)
    (ef-rss-subscriptions-configure ef-reader-rss-subscriptions-file)
    (camulus-jsonfeed-subscriptions-configure camulus-jsonfeed-subscriptions-file)
    (ef-content-state-configure ef-reader-state-file)
    (camulus-csrin-configure camulus-csrin-site)
    (ef-browser-profile-configure (or ef-reader-firefox-profile ""))
    (ef-discourse-setup)
    (when ef-reddit-username
      (ef-reddit-configure ef-reddit-username ef-reddit-token-file ef-reddit-client-id ef-reddit-redirect-uri))
    (when ef-mail-sender
      (ef-mail-configure ef-mail-root ef-mail-muhome ef-mail-sender
                         (or (executable-find "mu") "mu") ef-mail-account)
      (dolist (profile ef-mail-smtp-profiles) (apply #'ef-mail-configure-smtp profile))
      (dolist (account ef-mail-accounts) (apply #'ef-mail-configure-account account)))
    (clrhash ef-reader--requests) (clrhash ef-reader--completions) (clrhash ef-reader--loads)
    (clrhash ef-reader--states) (clrhash ef-reader--reading)
    (ef-probe-session-start)))


(defvar-local ef-reader--rss-query nil)
(defgroup camulus nil "Read backend feeds and discussions." :group 'applications)
(defcustom ef-reader-reply-indent 4
  "Display columns per reply level, for headings, bodies and attachments."
  :type 'natnum :group 'camulus)
(defface ef-reader-heading '((t (:weight bold)))
  "Heading of a reply." :group 'camulus)
(defface ef-reader-separator '((t (:inherit shadow :underline t)))
  "Thin rule under a reply heading." :group 'camulus)

(ef-reader-ui-install)
(provide 'camulus)
