;;; discourse-reader.el --- Discourse commands for the temporary reader -*- lexical-binding: t; -*-
(require 'auth-source)
(defvar ef-discourse-auth-sources nil "Additional auth-source files for configured Discourse accounts.")
(defvar ef-discourse-sites nil "Forum base URLs whose saved User API credentials should be loaded at startup.")
(defvar ef-discourse--callbacks (make-hash-table :test #'eql))
(defvar ef-discourse--likes (make-hash-table :test #'equal))
(defvar ef-discourse--like-values (make-hash-table :test #'equal))
(defvar-local ef-discourse--group "latest")
(defvar-local ef-discourse--query nil)
(defvar-local ef-discourse--cursor nil)
(defvar-local ef-discourse--append nil)
(defvar-local ef-discourse--page-rows nil)
(defun ef-discourse-setup ()
  (clrhash ef-discourse--callbacks)
  (clrhash ef-discourse--likes)
  (clrhash ef-discourse--like-values)
  (ef-discourse-clear-config)
  (let ((auth-sources (append ef-discourse-auth-sources auth-sources)))
  (dolist (site ef-discourse-sites)
    (let* ((site (ef-discourse-site site))
           ;; Reuse nndiscourse's device-login session when available, otherwise
           ;; read the same auth-source host/port/user/secret convention.
           (headers (if (fboundp 'discourse-auth-headers) (discourse-auth-headers site)
                      (let ((entry (car (auth-source-search :host site :port "discourse-user-api"
                                                            :require '(:user :secret) :max 1))))
                        (when entry
                          (mapcar (lambda (pair)
                                    (let ((value (plist-get entry (cdr pair))))
                                      (cons (car pair) (if (functionp value) (funcall value) value))))
                                  '(("User-Api-Key" . :secret) ("User-Api-Client-Id" . :user))))))))
      (ef-discourse-configure site (or (cdr (assoc "User-Api-Key" headers)) "")
                              (or (cdr (assoc "User-Api-Client-Id" headers)) ""))))))
(defun ef-discourse--request (request callback)
  (let ((id (camulus-discourse-submit request)))
    (puthash id callback ef-discourse--callbacks) id))
(defun ef-discourse--event (event)
  (when-let* ((callback (gethash (cadr event) ef-discourse--callbacks)))
    (pcase (car event)
      ('discourse (funcall callback
                          (nth 3 event) nil))
      ('finished
       (remhash (cadr event) ef-discourse--callbacks)
       (unless (eq (nth 3 event) 'completed)
         (funcall callback nil (nth 4 event))
         (message "Discourse: %s" (nth 4 event)))))))
(add-hook 'ef-probe-event-hook #'ef-discourse--event)
(define-derived-mode ef-reader-discourse-mode tabulated-list-mode "Discourse"
  (setq tabulated-list-format [("New" 3 nil) ("Source" 24 t) ("Author" 20 t) ("Topic" 70 t)]
        header-line-format "RET: thread  m: save  /: search group  n: more  g: refresh  c: categories  s: follow settings  h: home")
  (tabulated-list-init-header)
  (add-hook 'kill-buffer-hook (lambda ()
    (when (and ef-reader--active (not (equal (ef-probe-status) "idle")))
      (ef-probe-cancel ef-reader--active))) nil t))
(defun ef-reader-discourse (site &optional group)
  "Browse a forum's latest, category:ID, or topic:ID group without subscribing."
  (interactive (list (completing-read "Discourse forum URL: " ef-discourse-sites nil nil)
                     (read-string "Group (latest, category:ID, topic:ID): " "latest")))
  (setq site (ef-discourse-site site))
  (cl-pushnew site ef-discourse-sites :test #'equal)
  (ef-reader-start)
  (switch-to-buffer (get-buffer-create (format "*Reader Discourse: %s*" site)))
  (ef-reader-discourse-mode)
  (setq ef-reader--source (concat "discourse:" site) ef-discourse--group (or group "latest"))
  (ef-reader-discourse-refresh))
(defun ef-reader-discourse-refresh (&optional more)
  (interactive)
  (when (and more (not ef-discourse--cursor)) (user-error "No further page"))
  (when ef-reader--active (ef-probe-cancel ef-reader--active))
  (setq ef-discourse--append more)
  (setq ef-reader--active
        (camulus-discourse-submit `((op . ,(if ef-discourse--query "search" "list"))
                                             (site . ,(substring ef-reader--source 10)) (group . ,ef-discourse--group)
                                             (query . ,ef-discourse--query) (after . ,(and more ef-discourse--cursor)))))
  (puthash ef-reader--active (current-buffer) ef-reader--loads))
(defun ef-reader-discourse-more () (interactive) (ef-reader-discourse-refresh t))
(defun ef-reader-discourse-search (query)
  (interactive (list (read-string "Search this Discourse group (empty clears): ")))
  (setq ef-discourse--query (unless (string-empty-p query) query))
  (ef-reader-discourse-refresh))
(defun ef-discourse--page (data)
  (let ((rows (mapcar (lambda (m)
                       `((source . ,ef-reader--source) (target . "thread") (id . ,(alist-get 'id m))
                         (title . ,(alist-get 'title m)) (author . ,(alist-get 'author m))
                         (unread . ,(not (alist-get 'read (ef-reader--state ef-reader--source (alist-get 'id m)))))))
                     (alist-get 'messages data))))
    (setq ef-discourse--page-rows
          (if ef-discourse--append
              (cl-remove-duplicates (append ef-discourse--page-rows rows) :key (lambda (r) (alist-get 'id r)) :test #'equal)
            rows)
          ef-discourse--cursor (alist-get 'after data))
    (ef-reader--set-rows ef-discourse--page-rows)))
(defun ef-reader-discourse-categories ()
  (interactive)
  (let ((buffer (current-buffer)) (site (substring ef-reader--source 10)))
    (ef-discourse--request `((op . "categories") (site . ,site))
      (lambda (data _error)
        (when (and (buffer-live-p buffer) (equal (alist-get 'kind data) "categories"))
          (let* ((choices (mapcar (lambda (c) (cons (format "%s [%d]" (alist-get 'name c) (alist-get 'id c)) (alist-get 'group c)))
                                 (alist-get 'rows data)))
                 (group (cdr (assoc (completing-read "Category: " choices nil t) choices))))
            (when group (with-current-buffer buffer
                          (setq ef-discourse--group group ef-discourse--query nil)
                          (ef-reader-discourse-refresh)))))))))
(defun ef-discourse--apply-like (message source request)
  "Keep pending writes and older in-flight reads from reversing a local like."
  (let* ((key (list source (alist-get 'id message)))
         (pending (gethash key ef-discourse--likes))
         (overlay (gethash key ef-discourse--like-values)))
    (cond (pending (setf (alist-get 'liked message) (cdr pending)))
          ((and overlay (<= (or request 0) (car overlay)))
           (setf (alist-get 'liked message) (cadr overlay)
                 (alist-get 'like-uncertain message) (nth 2 overlay)))
          (overlay (remhash key ef-discourse--like-values))))
  message)
(defun ef-reader-discourse-like (&optional unlike)
  "Set a like on the current live Discourse article; with prefix, remove it."
  (interactive "P")
  (unless (and (derived-mode-p 'ef-reader-article-mode) (string-prefix-p "discourse:" ef-reader--source)
               (not ef-reader--archive)) (user-error "Open a live Discourse article"))
  (let* ((row (ef-reader--selected)) (id (alist-get 'id row)) (source ef-reader--source)
         (key (list source id)) (liked (not unlike))
         (message-data (gethash id ef-reader--messages))
         (previous (alist-get 'liked message-data)))
    (when (gethash key ef-discourse--likes) (user-error "A like request for this article is pending"))
    (unless (gethash id ef-reader--loaded) (user-error "Wait for the article to load"))
    (let ((request (ef-discourse--request `((op . "like") (site . ,(substring source 10)) (id . ,id)
                                           (liked . ,(if liked t :json-false)))
                     (lambda (data error)
                       (when (or error (equal (alist-get 'kind data) "liked"))
                         (let* ((pending (gethash key ef-discourse--likes))
                                (barrier (or (car pending) 0))
                                (uncertain (and error (or (string-match-p "uncertain" error) (string-empty-p error))))
                                (confirmed (if (and error (not uncertain)) previous liked)))
                           (dolist (buffer (buffer-list))
                             (with-current-buffer buffer
                               (when (and (derived-mode-p 'ef-reader-article-mode) (equal ef-reader--source source))
                                 (setq barrier (max barrier (or ef-reader--active 0))))))
                           (puthash key (list barrier confirmed uncertain) ef-discourse--like-values))
                         (remhash key ef-discourse--likes)
                         (let ((article (alist-get 'article data)))
                           (dolist (buffer (buffer-list))
                             (with-current-buffer buffer
                               (when (and (derived-mode-p 'ef-reader-article-mode) (not ef-reader--archive)
                                          (equal ef-reader--source source) (gethash id ef-reader--messages))
                                 (if article (ef-reader--receive article)
                                   (puthash id (ef-discourse--apply-like (gethash id ef-reader--messages) source ef-reader--active)
                                            ef-reader--messages)
                                   (ef-reader--render)))))))))))
      (puthash key (cons request liked) ef-discourse--likes)
      (dolist (buffer (buffer-list))
        (with-current-buffer buffer
          (when (and (derived-mode-p 'ef-reader-article-mode) (not ef-reader--archive)
                     (equal ef-reader--source source) (gethash id ef-reader--messages))
            (setf (alist-get 'liked (gethash id ef-reader--messages)) liked)
            (ef-reader--render)))))))
(dolist (binding '(("RET" . ef-reader-open) ("m" . ef-reader-save) ("g" . ef-reader-discourse-refresh)
                   ("/" . ef-reader-discourse-search) ("n" . ef-reader-discourse-more) ("c" . ef-reader-discourse-categories)
                   ("s" . ef-reader-subscription) ("h" . camulus)))
  (define-key ef-reader-discourse-mode-map (kbd (car binding)) (cdr binding)))
(provide 'discourse-reader)
