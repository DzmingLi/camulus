;;; writing-integration.el --- Controlled asynchronous draft completions -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'writing_probe)
(defvar writing-saves)
(defvar writing-sends)
(defun camulus-test-writing-save (source complete)
  (push (cons source complete) writing-saves))
(defun camulus-test-writing-send (complete) (push complete writing-sends))
(defmacro writing-with-draft (&rest body)
  `(let ((writing-saves nil) (writing-sends nil)
         (camulus-writing-autosave-delay 60)
         (draft (generate-new-buffer " *writing test*")))
     (unwind-protect
         (with-current-buffer draft
           (camulus-test-writing-attach)
           ,@body)
       (when (buffer-live-p draft)
         (with-current-buffer draft
           (let ((kill-buffer-query-functions nil)) (kill-buffer draft)))))))
(defun writing-wait (predicate)
  (let ((deadline (+ (float-time) 3)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.01))
    (should (funcall predicate))))

(ert-deftest writing-late-save-keeps-new-edits-and-isolates-buffers ()
  (writing-with-draft
   (insert "first")
   (camulus-writing-save)
   (let ((ack (cdar writing-saves)))
     (insert " second")
     (with-temp-buffer
       (insert "unrelated")
       (funcall ack t nil)
       (should (buffer-modified-p)))
     (should (buffer-modified-p))
     (camulus-writing-save)
     (should (equal (caar writing-saves) "first second"))
     (should (= (length writing-saves) 2))
     ;; A duplicate completion of the old snapshot cannot finish the new save.
     (funcall ack t nil)
     (should (buffer-modified-p))
     (funcall (cdar writing-saves) t nil)
     (should-not (buffer-modified-p)))))

(ert-deftest writing-autosave-reschedules-during-save-and-stops-on-error ()
  (writing-with-draft
   (setq camulus-writing-autosave-delay 0.01)
   (insert "first")
   (writing-wait (lambda () (= (length writing-saves) 1)))
   (insert " second")
   (funcall (cdar writing-saves) t nil)
   (writing-wait (lambda () (= (length writing-saves) 2)))
   (funcall (cdar writing-saves) nil "disk full")
   (insert " third")
   (accept-process-output nil 0.05)
   (should (= (length writing-saves) 2))
   (should (buffer-modified-p))
   (camulus-writing-save)
   (should (= (length writing-saves) 3))
   (funcall (cdar writing-saves) t nil)
   (should-not (buffer-modified-p))))

(ert-deftest writing-close-waits-for-save-and-detaches-timer ()
  (writing-with-draft
   (insert "persist before closing")
   (let (timer)
     (cl-letf (((symbol-function 'camulus-test-writing-save)
                (lambda (_source complete)
                  (setq timer (run-at-time 0.01 nil complete t nil)))))
       (camulus-writing-close))
     (should-not (buffer-live-p draft))
     (when (timerp timer) (cancel-timer timer)))
   (should-not writing-sends)))

(ert-deftest writing-save-error-vetoes-close-and-send ()
  (writing-with-draft
   (insert "valuable draft")
   (cl-letf (((symbol-function 'camulus-test-writing-save)
              (lambda (_source complete) (funcall complete nil "disk full"))))
     (should-not (kill-buffer draft))
     (should-not (camulus-writing--before-exit))
     (should (buffer-live-p draft))
     (should (buffer-modified-p))
     (should-error (camulus-writing-send))
     (should-not buffer-read-only)
     (should-not writing-sends))))

(ert-deftest writing-send-reserves-before-flush-and-never-replays-success ()
  (writing-with-draft
   (insert "submit once")
   (let (reentrant-error)
     (cl-letf (((symbol-function 'camulus-test-writing-save)
                (lambda (_source complete)
                  (run-at-time 0.01 nil
                               (lambda ()
                                 (with-current-buffer draft
                                   (setq reentrant-error
                                         (condition-case nil (progn (camulus-writing-send) nil)
                                           (error t))))
                                 (funcall complete t nil))))))
       (camulus-writing-send))
     (should reentrant-error))
   (should buffer-read-only)
   (should (= (length writing-sends) 1))
   (should-not (kill-buffer draft))
   (funcall (car writing-sends) nil "Sent; local cleanup incomplete; do not resend")
   (should (buffer-live-p draft))
   (should buffer-read-only)
   (should-not (buffer-modified-p))
   ;; A late failure must not undo the successful delivery acknowledgement.
   (funcall (car writing-sends) 'failed "late failure")
   (should buffer-read-only)
   (should-error (camulus-writing-send))
   (should (= (length writing-sends) 1))
   (should (kill-buffer draft))))

(ert-deftest writing-failed-send-restores-editing-without-automatic-retry ()
  (writing-with-draft
   (camulus-writing-send)
   (funcall (car writing-sends) 'failed "offline or outcome uncertain")
   (should-not buffer-read-only)
   (insert "keep editing")
   (should (= (length writing-sends) 1))
   (should (buffer-modified-p))))

(ert-deftest writing-success-closes-buffer-and-callback-after-kill-is-harmless ()
  (writing-with-draft
   (camulus-writing-send)
   (let ((complete (car writing-sends)))
     (funcall complete t "Sent")
     (should-not (buffer-live-p draft))
     (funcall complete 'failed "late error"))))
(ert-run-tests-batch-and-exit)
