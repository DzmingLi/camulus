;;; mail-integration.el --- Real mu, MIME and native process bridge -*- lexical-binding: t; -*-
(require 'ert)
(require 'camulus)
(setq camulus-probe-record-events t)
(require 'smtp-fixture)
(defvar camulus-mail-test-base (getenv "MAIL_FIXTURE"))
(unless camulus-mail-test-base (error "MAIL_FIXTURE is required"))
(defun camulus-mail-test-config (&optional program)
  (camulus-mail-configure (expand-file-name "Maildir" camulus-mail-test-base)
                     (expand-file-name "mu" camulus-mail-test-base) "bob@example.test"
                     (or program (executable-find "mu")) ""))
(defmacro camulus-mail-test-session (&rest body)
  `(progn (camulus-mail-test-config)
          (camulus-content-state-configure (expand-file-name "reader-state.sqlite" camulus-mail-test-base))
          (camulus-probe-session-start)
          (unwind-protect (progn ,@body) (camulus-probe-session-stop))))
(defun camulus-mail-test-finished (id)
  (cl-find-if (lambda (e) (and (eq (car e) 'finished) (= (nth 1 e) id))) camulus-probe--events))
(defun camulus-mail-test-await (id)
  (camulus-probe-await (lambda () (camulus-mail-test-finished id)) 20)
  (let ((event (camulus-mail-test-finished id)))
    (unless (eq (nth 3 event) 'completed) (error "Mail task failed: %s" event))))
(defun camulus-mail-test-data (id)
  (mapcar (lambda (e) (nth 3 e))
          (reverse (cl-remove-if-not (lambda (e) (and (eq (car e) 'mail) (= (cadr e) id))) camulus-probe--events))))
(defun camulus-mail-test-request (request)
  (let ((id (camulus-mail-submit request)))
    (camulus-mail-test-await id) (camulus-mail-test-data id)))

(ert-deftest mail-sync-starts-repeats-reindexes-and-refreshes-the-open-list ()
  (let* ((root (expand-file-name "Maildir" camulus-mail-test-base))
         (source (concat "maildir:" root))
         (box (expand-file-name "Sync-test" root))
         (stamp (make-temp-file "camulus-sync-runs"))
         (mail (make-temp-file "camulus-sync-message"))
         (camulus-mail-root root)
         (camulus-mail-sender "bob@example.test")
         (camulus-mail-sync-interval 1)
         (camulus-mail-sync-command
          (list (executable-find "sh") "-c" "printf 'run\\n' >> \"$1\"; sleep .3; cp \"$2\" \"$3\""
                "fixture-sync" stamp mail (expand-file-name "new/message" box))))
    (cl-labels ((runs () (with-temp-buffer (insert-file-contents stamp) (count-lines (point-min) (point-max)))))
      (unwind-protect
          (with-temp-buffer
            (dolist (sub '("cur" "new" "tmp")) (make-directory (expand-file-name sub box) t))
            (with-temp-file mail
              (insert "From: Alice <alice@example.test>\nTo: Bob <bob@example.test>\nSubject: Sync fixture\nMessage-ID: <auto-sync@example.test>\nDate: Fri, 16 Oct 2026 10:00:00 +0800\n\nSynced body.\n"))
            (camulus-reader-feed-mode)
            (setq camulus-reader--entry `((source . ,source) (group . "/Sync-test")))
            (camulus-mail-test-session
             (camulus-probe-await (lambda () (= (runs) 1)) 5)
             ;; An explicit refresh while the initial job is running must not
             ;; run a second sync command or queue one behind it.
             (camulus-mail-sync)
             (camulus-probe-await (lambda () (and camulus-reader--rows (= (hash-table-count camulus-reader--rows) 1))) 8)
             (should (equal "mail:auto-sync@example.test" (alist-get 'id (car (hash-table-values camulus-reader--rows)))))
             (camulus-probe-await (lambda () (>= (runs) 2)) 5)))
        (let ((before (runs)))
          (sit-for 1.1)
          (should (= before (runs))))
        (delete-file stamp) (delete-file mail)
        (when (file-directory-p box) (delete-directory box t))))))

(ert-deftest mail-entry-sync-offline-keeps-cache-and-retries-without-polling ()
  (let* ((stamp (make-temp-file "camulus-entry-sync"))
         (online (make-temp-name (expand-file-name "online-" camulus-mail-test-base)))
         (camulus-mail-sender "bob@example.test")
         (camulus-mail-sync-interval 0)
         (camulus-mail-sync-command
          (list (executable-find "sh") "-c"
                "printf 'run\\n' >> \"$1\"; sleep .1; test -e \"$2\""
                "entry-sync" stamp online))
         (entry `((name . "Mail")
                  (source . ,(concat "maildir:" (expand-file-name "Maildir" camulus-mail-test-base)))
                  (group . "/Inbox"))))
    (cl-labels ((runs () (with-temp-buffer (insert-file-contents stamp)
                          (count-lines (point-min) (point-max)))))
      (unwind-protect
          (camulus-mail-test-session
           (camulus-reader-browse-entry entry)
           (camulus-probe-await (lambda () (and (= (runs) 1)
                                                (= 0 (hash-table-count camulus-reader--completions)))))
           (camulus-probe-await (lambda () (> (hash-table-count camulus-reader--rows) 0)))
           (let ((ids (sort (mapcar #'prin1-to-string (hash-table-keys camulus-reader--rows)) #'string<)))
             (sit-for 1.1)
             (should (= (runs) 1))
             (should (equal ids (sort (mapcar #'prin1-to-string (hash-table-keys camulus-reader--rows)) #'string<))))
           (with-temp-file online (insert "online"))
           (camulus-reader-browse-entry entry)
           (camulus-probe-await (lambda () (and (= (runs) 2)
                                                (= 0 (hash-table-count camulus-reader--completions)))))
           (camulus-reader-refresh)
           (camulus-probe-await (lambda () (and (= (runs) 3)
                                                (= 0 (hash-table-count camulus-reader--completions)))))
           (sit-for 1.1)
           (should (= (runs) 3)))
        (dolist (path (list stamp online)) (when (file-exists-p path) (delete-file path)))
        (when (get-buffer "*Reader*") (kill-buffer "*Reader*"))))))

(ert-deftest mail-native-group-summary-and-search ()
  (camulus-mail-test-session
   (let* ((data (car (camulus-mail-test-request '((op . "list") (group . "/Inbox")))))
          (rows (alist-get 'messages data)))
     (should (= 3 (length rows)))
     (should (cl-find "mail:child@example.test" rows :key (lambda (r) (alist-get 'id r)) :test #'equal)))
   (let* ((data (car (camulus-mail-test-request '((op . "search") (group . "/Inbox") (query . "needle")))))
          (rows (alist-get 'messages data)))
     (should (= 1 (length rows)))
     (should-not (equal "mail:outside@example.test" (alist-get 'id (car rows)))))
   (should (camulus-probe-signals-unchanged))))

(ert-deftest mail-native-progressive-thread-and-attachment ()
  (camulus-mail-test-session
   (let* ((events (camulus-mail-test-request '((op . "thread") (id . "mail:root@example.test"))))
          (articles (cl-remove-if-not (lambda (x) (equal (alist-get 'kind x) "article")) events))
          (root (cl-find "mail:root@example.test" articles
                         :key (lambda (x) (alist-get 'id (alist-get 'message x))) :test #'equal))
          (attachments (alist-get 'attachments root))
          (download (expand-file-name "download.bin" camulus-mail-test-base)))
     (should (= 3 (length articles)))
     (should (alist-get 'complete (car (last events))))
     (should (equal "mail:reply@example.test"
                    (alist-get 'parent_id (alist-get 'message
                        (cl-find "mail:child@example.test" articles
                                 :key (lambda (x) (alist-get 'id (alist-get 'message x))) :test #'equal)))))
     (should (= 1 (length attachments)))
     (should (string-match-p "HTML 正文" (alist-get 'html (alist-get 'message root))))
     (when (file-exists-p download) (delete-file download))
     (camulus-mail-test-request `((op . "attachment") (id . "mail:root@example.test")
                             (part . ,(alist-get 'part (car attachments))) (destination . ,download)))
     (with-temp-buffer
       (set-buffer-multibyte nil) (insert-file-contents-literally download)
       (should (equal (buffer-string) "attachment\0bytes\n")))
     (should (= #o600 (file-modes download))))))

(ert-deftest mail-native-event-loop-and-cancellation ()
  (camulus-mail-test-config (expand-file-name "delayed-mu" camulus-mail-test-base))
  (camulus-probe-session-start)
  (let ((beats 0) timer)
    (setq timer (run-at-time 0.01 0.01 (lambda () (cl-incf beats))))
    (unwind-protect
        (progn
          (camulus-mail-test-request '((op . "list") (group . "/Inbox")))
          (should (> beats 5))
          (should (camulus-probe-signals-unchanged)))
      (cancel-timer timer) (camulus-probe-session-stop)))
  (camulus-mail-test-config (expand-file-name "slow-mu" camulus-mail-test-base))
  (camulus-probe-session-start)
  (unwind-protect
      (let ((id (camulus-mail-submit '((op . "list") (group . "/Inbox")))))
        (camulus-probe-await (lambda () (cl-some (lambda (p) (and (process-live-p p) (string-prefix-p "camulus-mail-" (process-name p)))) (process-list))))
        (camulus-probe-cancel id)
        (camulus-probe-await (lambda () (camulus-mail-test-finished id)))
        (should (eq (nth 3 (camulus-mail-test-finished id)) 'cancelled))
        (camulus-probe-await (lambda () (not (cl-some (lambda (p) (and (process-live-p p) (string-prefix-p "camulus-mail-" (process-name p)))) (process-list)))))
        (should (equal (camulus-probe-status) "running")))
    (camulus-probe-session-stop)))

(ert-deftest mail-reader-expanded-tree-with-attachment-pane ()
  (camulus-mail-test-session
   (unwind-protect
       (progn
         (camulus-reader-browse-entry `((name . "Mail") (source . ,(concat "maildir:" (expand-file-name "Maildir" camulus-mail-test-base))) (group . "/Inbox")))
         (camulus-probe-await (lambda () (= 0 (hash-table-count camulus-reader--requests))))
         (goto-char (point-min)) (search-forward "Re: 测试主题")
         (camulus-reader-open)
         (camulus-probe-await (lambda () (= 0 (hash-table-count camulus-reader--loads))))
         (with-current-buffer "*Reader thread*"
           (should (string-match-p "root body" (buffer-string)))
           (should (string-match-p "child body" (buffer-string)))
           (should (< (string-match "root body" (buffer-string)) (string-match "child body" (buffer-string))))
           (should-not (string-match-p "Save .*附件.bin" (buffer-string)))
           (should camulus-reader--complete)
           (goto-char (point-min))
           (search-forward "root body")
           (camulus-mail-attachments)
           (should (get-buffer-window "*Camulus mail attachments*"))
           (with-current-buffer "*Camulus mail attachments*"
             (should (derived-mode-p 'camulus-mail-attachments-mode))
             (should (equal (aref (cadar tabulated-list-entries) 0) "附件.bin"))
             (goto-char (point-min))
             (let ((destination (make-temp-name (expand-file-name "saved-attachment-" camulus-mail-test-base))))
               (unwind-protect
                   (cl-letf (((symbol-function 'read-file-name) (lambda (&rest _) destination)))
                     (camulus-mail-attachments-save)
                     (camulus-probe-await (lambda () (file-exists-p destination)))
                     (with-temp-buffer
                       (insert-file-contents-literally destination)
                       (should (equal (buffer-string) "attachment\0bytes\n"))))
                 (when (file-exists-p destination) (delete-file destination))))
             (let (opened)
               (cl-letf (((symbol-function 'find-file-other-window)
                          (lambda (path) (setq opened path))))
                 (camulus-mail-attachments-open)
                 (camulus-probe-await (lambda () opened))
                 (should (equal (file-name-nondirectory opened) "附件.bin"))
                 (should (file-exists-p opened))
                 (delete-directory (file-name-directory opened) t)))
             (camulus-mail-attachments-close))
           (should-not (get-buffer-window "*Camulus mail attachments*"))
           (camulus-mail-attachments--refresh)
           (should-not (get-buffer-window "*Camulus mail attachments*"))
           (camulus-mail-attachments)
           (should (get-buffer-window "*Camulus mail attachments*"))))
     (dolist (b '("*Reader thread*" "*Camulus mail attachments*" "*Reader*")) (when (get-buffer b) (kill-buffer b))))))

(ert-deftest mail-native-send-to-loopback-tls-only ()
  (camulus-mail-configure (expand-file-name "Maildir" camulus-mail-test-base)
                     (expand-file-name "mu" camulus-mail-test-base) "bob@example.test"
                     (executable-find "mu") "")
  (camulus-test-smtp camulus-mail-test-base "" "bob@example.test")
  (camulus-probe-session-start)
  (unwind-protect
      (let ((id (camulus-mail-submit
                 '((op . "send") (to . ["alice@example.test"])
                                (subject . "测试回复") (body . "A test reply")
                                (reply_to . "mail:root@example.test")))))
        (camulus-probe-close-view)
        (camulus-mail-test-await id)
        (should (equal (alist-get 'kind (car (camulus-mail-test-data id))) "sent"))
        (with-temp-buffer
          (insert-file-contents (expand-file-name "sent.eml" camulus-mail-test-base))
          (should (string-match-p "In-Reply-To: <root@example.test>" (buffer-string)))
          (should (string-match-p "From: bob@example.test" (buffer-string))))
        (should (camulus-probe-signals-unchanged)))
    (camulus-probe-session-stop)))

(ert-deftest mail-native-smtp-rejects-wrong-host-certificate ()
  (camulus-mail-test-config)
  (camulus-test-smtp camulus-mail-test-base "" "bob@example.test" "SMTP_WRONG_HOST_PORT" nil
                (expand-file-name "smtp-wrong-cert.pem" camulus-mail-test-base))
  (camulus-probe-session-start)
  (unwind-protect
      (let ((id (camulus-mail-submit '((op . "send") (to . ["a@example.test"]) (body . "never sent")))))
        (camulus-probe-await (lambda () (camulus-mail-test-finished id)) 10)
        (should (eq (nth 3 (camulus-mail-test-finished id)) 'failed))
        (should (camulus-probe-signals-unchanged)))
    (camulus-probe-session-stop)))

(ert-deftest mail-native-smtp-rejects-untrusted-certificate ()
