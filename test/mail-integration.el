(ert-deftest mail-native-smtp-wait-is-cancellable-and-keeps-heartbeat ()
  (camulus-mail-test-config)
  (camulus-test-smtp camulus-mail-test-base "" "bob@example.test" "SMTP_SLOW_PORT")
  (camulus-probe-session-start)
  (let ((beats 0) timer)
    (setq timer (run-at-time 0.01 0.01 (lambda () (cl-incf beats))))
    (unwind-protect
        (let ((id (camulus-mail-submit '((op . "send") (to . ["a@example.test"]) (body . "cancelled")))))
          (camulus-probe-await (lambda () (> beats 10)) 2)
          (should-not (camulus-mail-test-finished id))
          (camulus-probe-cancel id)
          (camulus-probe-await (lambda () (camulus-mail-test-finished id)) 2)
          (should (eq (nth 3 (camulus-mail-test-finished id)) 'cancelled))
          (should (camulus-probe-signals-unchanged)))
      (cancel-timer timer) (camulus-probe-session-stop))))
(ert-run-tests-batch-and-exit)
