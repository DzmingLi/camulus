;;; discourse-integration.el --- Synthetic native Discourse workflows -*- lexical-binding: t; -*-
(require 'ert)
(require 'camulus)
(setq ef-probe-record-events t)
(require 'url)
(defvar ef-discourse-test-site (or (getenv "DISCOURSE_FIXTURE") (error "DISCOURSE_FIXTURE required")))
(defun ef-discourse-test-control (mode)
  (let ((url-proxy-services nil))
    (kill-buffer (url-retrieve-synchronously (concat ef-discourse-test-site "/control/" mode) t t 5))))
(defun ef-discourse-test-finished (id)
  (cl-find-if (lambda (e) (and (eq (car e) 'finished) (= (cadr e) id))) ef-probe--events))
(defun ef-discourse-test-await (id)
  (ef-probe-await (lambda () (ef-discourse-test-finished id)) 15)
  (should (eq (nth 3 (ef-discourse-test-finished id)) 'completed)))
(defun ef-discourse-test-result (request kind &optional state)
  (let ((id (funcall (if state #'camulus-state-submit #'camulus-discourse-submit) request)))
    (ef-discourse-test-await id)
    (cl-find kind
             (mapcar (lambda (e) (nth 3 e))
                     (cl-remove-if-not (lambda (e) (and (eq (car e) (if state 'content-state 'discourse)) (= (cadr e) id))) ef-probe--events))
             :key (lambda (data) (alist-get 'kind data)) :test #'equal)))
(defun ef-discourse-test-idle ()
  (ef-probe-await (lambda () (and (= 0 (hash-table-count ef-reader--requests))
                                (= 0 (hash-table-count ef-reader--loads))
                                (= 0 (hash-table-count ef-discourse--callbacks)))) 15))
(defmacro ef-discourse-test-session (&rest body)
  `(let* ((directory (make-temp-file "discourse-reader" t))
          (ef-reader-config-file (expand-file-name "entries.json" directory))
          (ef-reader-rss-subscriptions-file (expand-file-name "rss-subscriptions.json" directory))
          (ef-reader-entries nil) (ef-reader-home nil)
          (ef-reader-state-file (expand-file-name "state.sqlite" directory))
          (ef-mail-sender nil) (ef-reddit-username nil)
          (ef-discourse-sites (list ef-discourse-test-site))
          (site ef-discourse-test-site) (source (concat "discourse:" site))
          (ef-reader-entries (list (list (cons 'name "Home") (cons 'source source) (cons 'group "topic:7"))))
          (ef-reader-home "Home"))
     (cl-letf (((symbol-function 'auth-source-search)
                (lambda (&rest args)
                  (should (equal (plist-get args :port) "discourse-user-api"))
                  (list (list :user "fixtureclient" :secret (lambda () "fixturekey"))))))
       (ef-discourse-test-control "reset")
       (ef-reader-start)
       (unwind-protect (save-window-excursion ,@body)
         (dolist (buffer (buffer-list))
           (with-current-buffer buffer
             (when (derived-mode-p 'ef-reader-feed-mode 'ef-reader-folder-mode 'ef-reader-article-mode 'ef-reader-discourse-mode)
               (kill-buffer buffer))))
         (ef-probe-session-stop) (ef-content-state-configure "")
         (delete-directory directory t)))))

(ert-deftest discourse-group-search-pagination-and-expanded-thread ()
  (ef-discourse-test-session
   (ef-reader-discourse site "category:3") (ef-discourse-test-idle)
   (should (= 1 (length tabulated-list-entries)))
   (ef-reader-discourse-more) (ef-discourse-test-idle)
   (should (= 2 (length tabulated-list-entries)))
   (ef-reader-discourse-search "missing") (ef-discourse-test-idle)
   (should-not tabulated-list-entries)
   (ef-reader-discourse-search "body") (ef-discourse-test-idle)
   (should (= 1 (length tabulated-list-entries)))
   (should-not (alist-get 'rows (ef-discourse-test-result `((op . "feed") (source . ,source) (group . ,"topic:7")) "feed" t)))
   (goto-char (point-min)) (ef-reader-open) (ef-discourse-test-idle)
   (with-current-buffer "*Reader thread*"
     (should (= 3 (hash-table-count ef-reader--messages)))
     (should ef-reader--complete)
     (should (equal (alist-get 'parent_id (gethash "topic:7/post:3" ef-reader--messages)) "topic:7/post:2"))
     (goto-char (point-min))
     (search-forward "Floor 1 body") (search-forward "Floor 2 body") (search-forward "Floor 3 body")
     (should (string-match-p "Save file.bin" (buffer-string))))))

(ert-deftest discourse-feed-dismiss-archive-new-reply-and-offline-attachments ()
  (ef-discourse-test-session
   (ef-discourse-test-result `((op . "refresh") (source . ,source) (group . ,"topic:7")) "feed" t)
   (camulus (car ef-reader-entries)) (ef-discourse-test-idle) (goto-char (point-min))
   (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "forums/keep")))
     (ef-reader-save) (ef-discourse-test-idle))
   (ef-reader-delete) (ef-discourse-test-idle)
   (should-not (alist-get 'rows (ef-discourse-test-result `((op . "refresh") (source . ,source) (group . ,"topic:7")) "feed" t)))
   (ef-discourse-test-control "update")
   (should (= 1 (length (alist-get 'rows (ef-discourse-test-result `((op . "refresh") (source . ,source) (group . ,"topic:7")) "feed" t)))))
   (ef-discourse-test-result '((op . "refresh-archives")) "archives-refreshed" t)
   (ef-probe-session-stop) (ef-reader-start)
   (ef-discourse-test-control "offline")
   (with-current-buffer (get-buffer-create "*Discourse saved*")
     (ef-reader-folder-mode) (setq ef-reader--folder "forums/keep") (ef-reader--load-list))
   (ef-discourse-test-idle)
   (with-current-buffer "*Discourse saved*" (goto-char (point-min)) (ef-reader-open))
   (ef-discourse-test-idle)
   (with-current-buffer "*Reader thread*"
     (should ef-reader--archive)
     (should (= 4 (hash-table-count ef-reader--messages)))
     (should (string-match-p "Floor 4 body" (buffer-string))))
   (let ((destination (expand-file-name "attachment.bin" directory)))
     (ef-discourse-test-result `((op . "attachment") (source . ,source) (id . "topic:7/post:2")
                                 (part . 0) (destination . ,destination)) "saved" t)
     (with-temp-buffer (set-buffer-multibyte nil) (insert-file-contents-literally destination)
                      (should (equal (buffer-string) (concat "Discourse\0attachment" (unibyte-string 255))))))))

(ert-deftest discourse-user-api-optimistic-like-reply-and-tracking ()
  (ef-discourse-test-session
   (ef-reader-discourse site "topic:7") (ef-discourse-test-idle)
   (goto-char (point-min)) (ef-reader-open) (ef-discourse-test-idle)
   (with-current-buffer "*Reader thread*"
     (goto-char (point-min)) (ef-reader-discourse-like)
     (should (alist-get 'liked (gethash "topic:7/post:1" ef-reader--messages))))
   (ef-discourse-test-idle)
   (with-current-buffer "*Reader thread*"
     (should (alist-get 'liked (gethash "topic:7/post:1" ef-reader--messages)))
     (goto-char (point-min)) (ef-reader-discourse-like t))
   (ef-discourse-test-idle)
   (with-current-buffer "*Reader thread*"
     (should-not (alist-get 'liked (gethash "topic:7/post:1" ef-reader--messages))))
   (let ((result (ef-discourse-test-result `((op . "reply") (site . ,site) (id . "topic:7/post:2") (text . "Synthetic test reply")) "sent")))
     (should (equal (alist-get 'parent_id (alist-get 'message (alist-get 'article result))) "topic:7/post:2")))
   (ef-discourse-test-result `((op . "track") (site . ,site) (id . "topic:7") (level . "watching")) "tracked")
   (should (= 3 (alist-get 'level (ef-discourse-test-result `((op . "topic-state") (site . ,site) (id . "topic:7")) "topic-state"))))))

(ert-deftest discourse-slow-request-is-cancellable ()
  (ef-discourse-test-session
   (let* ((id (camulus-discourse-submit `((op . "thread") (site . ,site) (id . "topic:99"))))
          (other (ef-probe-submit 10 1 t nil 0)))
     (ef-discourse-test-await other)
     (should-not (ef-discourse-test-finished id))
     (should (ef-probe-cancel id))
     (ef-probe-await (lambda () (ef-discourse-test-finished id)) 3)
     (should (eq (nth 3 (ef-discourse-test-finished id)) 'cancelled)))))
(ert-deftest discourse-like-overlay-reconciles-pending-stale-and-newer-reads ()
  (let ((ef-discourse--likes (make-hash-table :test #'equal))
        (ef-discourse--like-values (make-hash-table :test #'equal))
        (key '("discourse:test" "topic:7/post:1")))
    (puthash key '(10 . t) ef-discourse--likes)
    (let ((m (copy-tree '((id . "topic:7/post:1") (liked . nil)))))
      (setq m (ef-discourse--apply-like m "discourse:test" 11))
      (should (alist-get 'liked m)))
    (remhash key ef-discourse--likes)
    (puthash key '(12 t nil) ef-discourse--like-values)
    (let ((m (copy-tree '((id . "topic:7/post:1") (liked . nil)))))
      (setq m (ef-discourse--apply-like m "discourse:test" 12))
      (should (alist-get 'liked m)))
    (let ((m (copy-tree '((id . "topic:7/post:1") (liked . nil)))))
      (setq m (ef-discourse--apply-like m "discourse:test" 13))
      (should-not (alist-get 'liked m))
      (should-not (gethash key ef-discourse--like-values)))
    (puthash key '(15 t t) ef-discourse--like-values)
    (let ((m (copy-tree '((id . "topic:7/post:1") (liked . nil)))))
      (setq m (ef-discourse--apply-like m "discourse:test" 15))
      (should (alist-get 'like-uncertain m)))))
(ert-deftest discourse-personal-entry-reflects-remote-following ()
  (ef-discourse-test-session
   (let ((entry `((name . "Watching") (source . ,source) (group . "watching"))))
     (camulus entry) (ef-discourse-test-idle)
     (ef-reader-refresh) (ef-discourse-test-idle)
     (should-not tabulated-list-entries)
     ;; Use the common subscription UI from an ordinary browse entry.
     (ef-reader-discourse site "topic:7") (ef-discourse-test-idle)
     (goto-char (point-min))
     (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "watching")))
       (ef-reader-subscription) (ef-discourse-test-idle))
     (camulus entry) (ef-discourse-test-idle)
     (ef-reader-refresh) (ef-discourse-test-idle)
     (should (= 1 (length tabulated-list-entries)))
     (ef-reader-search "missing") (ef-discourse-test-idle)
     (should-not tabulated-list-entries)
     (ef-reader-search "") (ef-discourse-test-idle)
     (should (= 1 (length tabulated-list-entries)))
     (goto-char (point-min)) (ef-reader-delete) (ef-discourse-test-idle)
     (should-not tabulated-list-entries)
     (should (= 3 (alist-get 'level (ef-discourse-test-result `((op . "topic-state") (site . ,site) (id . "topic:7")) "topic-state"))))
     ;; A new remote reply restores the row, then a remote unwatch removes it.
     (ef-discourse-test-control "update")
     (ef-reader-refresh) (ef-discourse-test-idle)
     (should (= 1 (length tabulated-list-entries)))
     (ef-discourse-test-control "reset")
     (ef-reader-refresh) (ef-discourse-test-idle)
     (should-not tabulated-list-entries))))
(ert-deftest discourse-overlapping-entry-refresh-preserves-newer-cache ()
  (ef-discourse-test-session
   (ef-discourse-test-control "delay-list")
   (let ((old (camulus-state-submit `((op . "refresh") (source . ,source) (group . "latest")))))
     (let ((url-proxy-services nil))
       (ef-probe-await
        (lambda ()
          (with-current-buffer (url-retrieve-synchronously (concat site "/control/status") t t 5)
            (unwind-protect
                (progn (goto-char (point-min)) (re-search-forward "\n\n" nil t)
                       (alist-get 'list_started (json-parse-buffer :object-type 'alist :false-object nil)))
              (kill-buffer (current-buffer))))) 5))
     (ef-discourse-test-control "update")
     (let* ((new (ef-discourse-test-result `((op . "refresh") (source . ,source) (group . "latest")) "feed" t))
            (row (car (alist-get 'rows new))))
       (ef-discourse-test-result `((op . "dismiss") (source . ,source) (group . "latest")
                                  (id . ,(alist-get 'id row)) (revision . ,(alist-get 'revision row))) "changed" t)
       (ef-discourse-test-await old)
       ;; A late revision 3 response must neither replace revision 4 nor create a new event.
       (should-not (alist-get 'rows (ef-discourse-test-result
                                    `((op . "feed") (source . ,source) (group . "latest")) "feed" t)))))))
(ert-run-tests-batch-and-exit)
