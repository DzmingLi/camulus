;;; discourse-integration.el --- Synthetic native Discourse workflows -*- lexical-binding: t; -*-
(require 'ert)
(require 'camulus)
(setq camulus-probe-record-events t)
(require 'url)
(defvar camulus-discourse-test-site (or (getenv "DISCOURSE_FIXTURE") (error "DISCOURSE_FIXTURE required")))
(defun camulus-discourse-test-control (mode)
  (let ((url-proxy-services nil))
    (kill-buffer (url-retrieve-synchronously (concat camulus-discourse-test-site "/control/" mode) t t 5))))
(defun camulus-discourse-test-finished (id)
  (cl-find-if (lambda (e) (and (eq (car e) 'finished) (= (cadr e) id))) camulus-probe--events))
(defun camulus-discourse-test-await (id)
  (camulus-probe-await (lambda () (camulus-discourse-test-finished id)) 15)
  (should (eq (nth 3 (camulus-discourse-test-finished id)) 'completed)))
(defun camulus-discourse-test-result (request kind &optional state)
  (let ((id (funcall (if state #'camulus-state-submit #'camulus-discourse-submit) request)))
    (camulus-discourse-test-await id)
    (cl-find kind
             (mapcar (lambda (e) (nth 3 e))
                     (cl-remove-if-not (lambda (e) (and (eq (car e) (if state 'content-state 'discourse)) (= (cadr e) id))) camulus-probe--events))
             :key (lambda (data) (alist-get 'kind data)) :test #'equal)))
(defun camulus-discourse-test-idle ()
  (camulus-probe-await (lambda () (and (= 0 (hash-table-count camulus-reader--requests))
                                (= 0 (hash-table-count camulus-reader--loads))
                                (= 0 (hash-table-count camulus-discourse--callbacks)))) 15))
(defmacro camulus-discourse-test-session (&rest body)
  `(let* ((directory (make-temp-file "discourse-reader" t))
          (camulus-reader-config-file (expand-file-name "config.json" directory))
          (camulus-reader-groups-file (expand-file-name "groups.json" directory))
          (camulus-group-subscriptions-file (expand-file-name "group-subscriptions.json" directory))
          (camulus-reader-rss-subscriptions-file (expand-file-name "rss-subscriptions.json" directory))
          (camulus-groups nil)
          (camulus-state-file (expand-file-name "state.sqlite" directory))
          (camulus-mail-sender nil) (camulus-reddit-username nil)
          (camulus-discourse-sites (list camulus-discourse-test-site))
          (site camulus-discourse-test-site) (source (concat "discourse:" site))
          (camulus-groups (list (list (cons 'name "Home") (cons 'source source) (cons 'group "topic:7"))))
         )
     (cl-letf (((symbol-function 'auth-source-search)
                (lambda (&rest args)
                  (should (equal (plist-get args :port) "discourse-user-api"))
                  (list (list :user "fixtureclient" :secret (lambda () "fixturekey"))))))
       (camulus-discourse-test-control "reset")
       (camulus-reader-start)
       (unwind-protect (save-window-excursion ,@body)
         (dolist (buffer (buffer-list))
           (with-current-buffer buffer
             (when (derived-mode-p 'camulus-reader-feed-mode 'camulus-reader-folder-mode 'camulus-reader-article-mode 'camulus-reader-discourse-mode 'camulus-tracking-mode)
               (kill-buffer buffer))))
         (camulus-probe-session-stop) (camulus-content-state-configure "")
         (delete-directory directory t)))))

(ert-deftest discourse-group-search-pagination-and-expanded-thread ()
  (camulus-discourse-test-session
   (camulus-reader-discourse site "category:3") (camulus-discourse-test-idle)
   (should (= 1 (length tabulated-list-entries)))
   (camulus-reader-discourse-more) (camulus-discourse-test-idle)
   (should (= 2 (length tabulated-list-entries)))
   (camulus-reader-discourse-search "missing") (camulus-discourse-test-idle)
   (should-not tabulated-list-entries)
   (camulus-reader-discourse-search "body") (camulus-discourse-test-idle)
   (should (= 1 (length tabulated-list-entries)))
   (should-not (alist-get 'rows (camulus-discourse-test-result `((op . "feed") (source . ,source) (group . ,"topic:7")) "feed" t)))
   (goto-char (point-min)) (camulus-reader-open) (camulus-discourse-test-idle)
   (with-current-buffer "*Reader thread*"
     (should (= 3 (hash-table-count camulus-reader--messages)))
     (should camulus-reader--complete)
     (should (equal (alist-get 'parent_id (gethash "topic:7/post:3" camulus-reader--messages)) "topic:7/post:2"))
     (goto-char (point-min))
     (search-forward "Floor 1 body") (search-forward "Floor 2 body") (search-forward "Floor 3 body")
     (should (string-match-p "Save file.bin" (buffer-string))))))

(ert-deftest discourse-feed-dismiss-archive-new-reply-and-offline-attachments ()
  (camulus-discourse-test-session
   (camulus-discourse-test-result `((op . "refresh") (source . ,source) (group . ,"topic:7")) "feed" t)
   (camulus (car camulus-groups)) (camulus-discourse-test-idle) (goto-char (point-min))
   (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "forums/keep")))
     (camulus-reader-save) (camulus-discourse-test-idle))
   (camulus-reader-delete) (camulus-discourse-test-idle)
   (should-not (alist-get 'rows (camulus-discourse-test-result `((op . "refresh") (source . ,source) (group . ,"topic:7")) "feed" t)))
   (camulus-discourse-test-control "update")
   (should (= 1 (length (alist-get 'rows (camulus-discourse-test-result `((op . "refresh") (source . ,source) (group . ,"topic:7")) "feed" t)))))
   (camulus-discourse-test-result '((op . "refresh-archives")) "archives-refreshed" t)
   (camulus-probe-session-stop) (camulus-reader-start)
   (camulus-discourse-test-control "offline")
   (with-current-buffer (get-buffer-create "*Discourse saved*")
     (camulus-reader-folder-mode) (setq camulus-reader--folder "forums/keep") (camulus-reader--load-list))
   (camulus-discourse-test-idle)
   (with-current-buffer "*Discourse saved*" (goto-char (point-min)) (camulus-reader-open))
   (camulus-discourse-test-idle)
   (with-current-buffer "*Reader thread*"
     (should camulus-reader--archive)
     (should (= 4 (hash-table-count camulus-reader--messages)))
     (should (string-match-p "Floor 4 body" (buffer-string))))
   (let ((destination (expand-file-name "attachment.bin" directory)))
     (camulus-discourse-test-result `((op . "attachment") (source . ,source) (id . "topic:7/post:2")
                                 (part . 0) (destination . ,destination)) "saved" t)
     (with-temp-buffer (set-buffer-multibyte nil) (insert-file-contents-literally destination)
                      (should (equal (buffer-string) (concat "Discourse\0attachment" (unibyte-string 255))))))))

(ert-deftest discourse-user-api-optimistic-like-reply-and-tracking ()
  (camulus-discourse-test-session
   (camulus-reader-discourse site "topic:7") (camulus-discourse-test-idle)
   (goto-char (point-min)) (camulus-reader-open) (camulus-discourse-test-idle)
   (with-current-buffer "*Reader thread*"
     (goto-char (point-min)) (camulus-reader-discourse-like)
     (should (alist-get 'liked (gethash "topic:7/post:1" camulus-reader--messages))))
   (camulus-discourse-test-idle)
   (with-current-buffer "*Reader thread*"
     (should (alist-get 'liked (gethash "topic:7/post:1" camulus-reader--messages)))
     (goto-char (point-min)) (camulus-reader-discourse-like t))
   (camulus-discourse-test-idle)
   (with-current-buffer "*Reader thread*"
     (should-not (alist-get 'liked (gethash "topic:7/post:1" camulus-reader--messages))))
   (let ((result (camulus-discourse-test-result `((op . "reply") (site . ,site) (id . "topic:7/post:2") (text . "Synthetic test reply")) "sent")))
     (should (equal (alist-get 'parent_id (alist-get 'message (alist-get 'article result))) "topic:7/post:2")))
   (camulus-discourse-test-result `((op . "track") (site . ,site) (id . "topic:7") (level . "watching")) "tracked")
   (should (= 3 (alist-get 'level (camulus-discourse-test-result `((op . "topic-state") (site . ,site) (id . "topic:7")) "topic-state"))))))

(ert-deftest discourse-slow-request-is-cancellable ()
  (camulus-discourse-test-session
   (let* ((id (camulus-discourse-submit `((op . "thread") (site . ,site) (id . "topic:99"))))
          (other (camulus-probe-submit 10 1 t nil 0)))
     (camulus-discourse-test-await other)
     (should-not (camulus-discourse-test-finished id))
     (should (camulus-probe-cancel id))
     (camulus-probe-await (lambda () (camulus-discourse-test-finished id)) 3)
     (should (eq (nth 3 (camulus-discourse-test-finished id)) 'cancelled)))))
(ert-deftest discourse-like-overlay-reconciles-pending-stale-and-newer-reads ()
  (let ((camulus-discourse--likes (make-hash-table :test #'equal))
        (camulus-discourse--like-values (make-hash-table :test #'equal))
        (key '("discourse:test" "topic:7/post:1")))
    (puthash key '(10 . t) camulus-discourse--likes)
    (let ((m (copy-tree '((id . "topic:7/post:1") (liked . nil)))))
      (setq m (camulus-discourse--apply-like m "discourse:test" 11))
      (should (alist-get 'liked m)))
    (remhash key camulus-discourse--likes)
    (puthash key '(12 t nil) camulus-discourse--like-values)
    (let ((m (copy-tree '((id . "topic:7/post:1") (liked . nil)))))
      (setq m (camulus-discourse--apply-like m "discourse:test" 12))
      (should (alist-get 'liked m)))
    (let ((m (copy-tree '((id . "topic:7/post:1") (liked . nil)))))
      (setq m (camulus-discourse--apply-like m "discourse:test" 13))
      (should-not (alist-get 'liked m))
      (should-not (gethash key camulus-discourse--like-values)))
    (puthash key '(15 t t) camulus-discourse--like-values)
    (let ((m (copy-tree '((id . "topic:7/post:1") (liked . nil)))))
      (setq m (camulus-discourse--apply-like m "discourse:test" 15))
      (should (alist-get 'like-uncertain m)))))
(ert-deftest discourse-personal-entry-reflects-remote-following ()
  (camulus-discourse-test-session
   (let ((entry `((name . "Watching") (source . ,source) (group . "watching"))))
     (camulus entry) (camulus-discourse-test-idle)
     (camulus-reader-refresh) (camulus-discourse-test-idle)
     (should-not tabulated-list-entries)
     ;; Use the common subscription UI from an ordinary browse entry.
     (camulus-reader-discourse site "topic:7") (camulus-discourse-test-idle)
     (goto-char (point-min))
     (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "watching")))
       (camulus-reader-subscription) (camulus-discourse-test-idle))
     (camulus entry) (camulus-discourse-test-idle)
     (camulus-reader-refresh) (camulus-discourse-test-idle)
     (should (= 1 (length tabulated-list-entries)))
     (camulus-reader-search "missing") (camulus-discourse-test-idle)
     (should-not tabulated-list-entries)
     (camulus-reader-search "") (camulus-discourse-test-idle)
     (should (= 1 (length tabulated-list-entries)))
     (goto-char (point-min)) (camulus-reader-delete) (camulus-discourse-test-idle)
     (should-not tabulated-list-entries)
     (should (= 3 (alist-get 'level (camulus-discourse-test-result `((op . "topic-state") (site . ,site) (id . "topic:7")) "topic-state"))))
     ;; A new remote reply restores the row, then a remote unwatch removes it.
     (camulus-discourse-test-control "update")
     (camulus-reader-refresh) (camulus-discourse-test-idle)
     (should (= 1 (length tabulated-list-entries)))
     (camulus-discourse-test-control "reset")
     (camulus-reader-refresh) (camulus-discourse-test-idle)
     (should-not tabulated-list-entries))))
(ert-deftest discourse-overlapping-entry-refresh-preserves-newer-cache ()
  (camulus-discourse-test-session
   (camulus-discourse-test-control "delay-list")
   (let ((old (camulus-state-submit `((op . "refresh") (source . ,source) (group . "latest")))))
     (let ((url-proxy-services nil))
       (camulus-probe-await
        (lambda ()
          (with-current-buffer (url-retrieve-synchronously (concat site "/control/status") t t 5)
            (unwind-protect
                (progn (goto-char (point-min)) (re-search-forward "\n\n" nil t)
                       (alist-get 'list_started (json-parse-buffer :object-type 'alist :false-object nil)))
              (kill-buffer (current-buffer))))) 5))
     (camulus-discourse-test-control "update")
     (let* ((new (camulus-discourse-test-result `((op . "refresh") (source . ,source) (group . "latest")) "feed" t))
            (row (car (alist-get 'rows new))))
       (camulus-discourse-test-result `((op . "dismiss") (source . ,source) (group . "latest")
                                  (id . ,(alist-get 'id row)) (revision . ,(alist-get 'revision row))) "changed" t)
       (camulus-discourse-test-await old)
       ;; A late revision 3 response must neither replace revision 4 nor create a new event.
       (should-not (alist-get 'rows (camulus-discourse-test-result
                                    `((op . "feed") (source . ,source) (group . "latest")) "feed" t)))))))
(ert-deftest discourse-remote-tracking-panel-pages-opens-and-updates-server ()
  (camulus-discourse-test-session
   (camulus-discourse-test-control "manage")
   (camulus-manage-subscriptions source)
   (camulus-discourse-test-idle)
   (should (eq major-mode 'camulus-tracking-mode))
   (let ((panel (current-buffer)))
     (should (equal (mapcar (lambda (r) (alist-get 'id r)) camulus-tracking--rows) '("topic:7")))
     (should camulus-tracking--after)
     (camulus-tracking-more) (camulus-discourse-test-idle)
     (should (= 2 (length camulus-tracking--rows)))
     (should-not camulus-tracking--after)
     (goto-char (point-min))
     (camulus-reader-open) (camulus-discourse-test-idle)
     (should (eq major-mode 'camulus-reader-article-mode))
     (should (string-match-p "Floor 1 body" (buffer-string)))
     (switch-to-buffer panel)
     (goto-char (point-min))
     (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "tracking")))
       (camulus-tracking-change) (camulus-discourse-test-idle))
     (should-not camulus-tracking--busy)
     (should-not camulus-tracking--error)
     (should (equal (mapcar (lambda (r) (alist-get 'id r)) camulus-tracking--rows) '("topic:9")))
     (should (= 2 (alist-get 'level (camulus-discourse-test-result
                                    `((op . "topic-state") (site . ,site) (id . "topic:7")) "topic-state"))))
     ;; A policy change in the reader refreshes the same management panel.
     (switch-to-buffer "*Reader thread*") (goto-char (point-min))
     (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "watching")))
       (camulus-reader-subscription) (camulus-discourse-test-idle))
     (with-current-buffer panel
       (should (equal (alist-get 'id (car camulus-tracking--rows)) "topic:7")))
     ;; Managing remote tracking never creates a local subscription file.
     (should-not (file-exists-p camulus-group-subscriptions-file)))))

(ert-deftest discourse-remote-tracking-refresh-external-change-and-failure ()
  (camulus-discourse-test-session
   (camulus-discourse-test-control "manage")
   (camulus-manage-subscriptions source) (camulus-discourse-test-idle)
   (camulus-discourse-test-control "manage-external")
   (camulus-tracking-refresh) (camulus-discourse-test-idle)
   (should (equal (alist-get 'id (car camulus-tracking--rows)) "topic:9"))
   (camulus-discourse-test-control "reject-tracking")
   (goto-char (point-min))
   (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "regular")))
     (camulus-tracking-change) (camulus-discourse-test-idle))
   (should camulus-tracking--error)
   (should-not camulus-tracking--busy)
   (should (equal (alist-get 'setting (car camulus-tracking--rows)) "watching"))
   (should (string-match-p "Error:" header-line-format))
   (camulus-discourse-test-control "offline")
   (camulus-tracking-refresh) (camulus-discourse-test-idle)
   (should camulus-tracking--error)
   (should (= 1 (length camulus-tracking--rows)))))

(ert-deftest discourse-remote-tracking-filter-discards-late-page ()
  (camulus-discourse-test-session
   (camulus-discourse-test-control "manage")
   (camulus-manage-subscriptions source) (camulus-discourse-test-idle)
   (camulus-discourse-test-control "delay-list")
   (camulus-tracking-refresh)
   (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "tracking · 追踪")))
     (camulus-tracking-filter))
   (camulus-discourse-test-idle)
   (should (equal camulus-tracking--filter "tracking"))
   (should (equal (mapcar (lambda (r) (alist-get 'id r)) camulus-tracking--rows) '("topic:8")))
   (should-not camulus-tracking--error)))

(ert-run-tests-batch-and-exit)
