;;; webkit-integration.el --- Shared WebKit boundary, without a display/network -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'webkit_probe)
(defvar webkit-cookie-file "unchanged-cookie-file")
(defvar webkit-new-hook '(unchanged-hook))
(defvar webkit-mode-hook nil)
(defvar webkit-own-window t)
(defvar-local webkit--id nil)
(defvar camulus-test-webkit-message nil)
(defvar camulus-test-webkit-error nil)
(defvar camulus-test-webkit-closed 0)

(defmacro camulus-with-test-webkit (&rest body)
  `(let ((original-require (symbol-function 'require))
         (uri "https://example.test/page") (javascript nil) (channel nil)
         (process nil) (camulus-test-webkit-message nil)
         (camulus-test-webkit-error nil) (camulus-test-webkit-closed 0))
     (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t))
               ((symbol-function 'require)
                (lambda (feature &rest args)
                  (if (memq feature '(webkit webkit-module)) t
                    (apply original-require feature args))))
               ((symbol-function 'webkit-new)
                (lambda (_url name _noquery)
                  (should-not webkit-cookie-file)
                  (should-not webkit-new-hook)
                  (should-not webkit-own-window)
                  (switch-to-buffer (generate-new-buffer name))
                  (special-mode)
                  (setq-local webkit--id t)
                  (setq process (make-pipe-process :name "test-webkit" :buffer (current-buffer) :noquery t))
                  (current-buffer)))
               ((symbol-function 'webkit--get-uri) (lambda (_) uri))
               ((symbol-function 'webkit--register-script-message) (lambda (_ name) (setq channel name)))
               ((symbol-function 'webkit--execute-js) (lambda (_ code) (setq javascript code)))
               ((symbol-function 'webkit--load-uri) #'ignore)
               ((symbol-function 'webkit--enable-javascript) #'ignore))
       (unwind-protect
           (progn (camulus-test-webkit-open) ,@body)
         (camulus-test-webkit-close)
         (when (process-live-p process) (delete-process process))))))

(ert-deftest webkit-channel-is-bounded-private-and-fixed ()
  (camulus-with-test-webkit
   (should (equal webkit-cookie-file "unchanged-cookie-file"))
   (should (equal webkit-new-hook '(unchanged-hook)))
   (should webkit-own-window)
   (should (equal channel "testChannel"))
   (let ((filter (process-filter process)))
     (funcall filter process "webkit--load-finished\0\0")
     (should (equal javascript "test-script"))
     (funcall filter process "testChannel\0priv")
     (should-not camulus-test-webkit-message)
     (funcall filter process "ate-ticket\0")
     (should (equal camulus-test-webkit-message "private-ticket"))
     (should (equal (buffer-string) ""))
     (cl-letf (((symbol-function 'evil-callback) (lambda (&rest _) (ert-fail "Page executed a Lisp function"))))
       (funcall filter process "evil-callback\0payload\0"))
     (camulus-test-webkit-close)
     (camulus-test-webkit-close)
     (should (= camulus-test-webkit-closed 1))
     (funcall filter process "testChannel\0late\0")
     (should (equal camulus-test-webkit-message "private-ticket")))))

(ert-deftest webkit-rejects-cross-origin-messages ()
  (camulus-with-test-webkit
   (let ((filter (process-filter process)))
     (funcall filter process "webkit--load-finished\0\0")
     (setq uri "https://evil.test/")
     (funcall filter process "testChannel\0stolen\0")
     (should camulus-test-webkit-error)
     (should-not camulus-test-webkit-message))))

(ert-deftest webkit-rejects-unbounded-messages ()
  (camulus-with-test-webkit
   (funcall (process-filter process) process (make-string 65537 ?a))
   (should camulus-test-webkit-error)
   (should-not camulus-test-webkit-message)))

(ert-run-tests-batch-and-exit)
