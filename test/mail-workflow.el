;;; mail-workflow-tests --- Native mutations on synthetic mail only -*- lexical-binding: t; -*-
(require 'ert)
(require 'camulus)
(setq ef-probe-record-events t)
(require 'smtp-fixture)
(defvar wf-base (getenv "MAIL_FIXTURE"))
;; Message mode also creates its own crash-recovery autosave directory.
;; Keep it inside the fixture, even when the build has no writable home.
(setq message-auto-save-directory (expand-file-name "message-autosave/" wf-base))
(defun wf-start ()
  (ef-mail-configure (expand-file-name "Maildir" wf-base) (expand-file-name "mu" wf-base)
                     "bob@example.test" (executable-find "mu") "")
  (ef-test-smtp wf-base "work" "work@example.test")
  (ef-test-smtp wf-base "second" "second@example.test")
  (ef-mail-configure-account "/work" "work@example.test" "work")
  (ef-mail-configure-account "/second" "second@example.test" "second")
  (ef-probe-session-start))
(defun wf-finished (id)
  (cl-find-if (lambda (e) (and (eq (car e) 'finished) (= (cadr e) id))) ef-probe--events))
(defun wf-request (request &optional failure)
  (let ((id (camulus-mail-submit request)))
    (ef-probe-await (lambda () (wf-finished id)) 20)
    (if failure (should (eq (nth 3 (wf-finished id)) 'failed))
      (should (eq (nth 3 (wf-finished id)) 'completed)))
    (when-let* ((data (cl-find-if (lambda (e) (and (eq (car e) 'mail) (= (cadr e) id))) ef-probe--events)))
      (nth 3 data))))
(defun wf-draft (group)
  (alist-get 'draft (wf-request `((op . "draft-new") (group . ,group)))))

(ert-deftest workflow-archive-retains-bytes-flags-and-group-scope ()
  (wf-start)
  (unwind-protect
      (let* ((source (expand-file-name "Maildir/work/Inbox/cur/archive-root,U=77:2,FR" wf-base))
             (hash (with-temp-buffer (insert-file-contents-literally source) (secure-hash 'sha256 (current-buffer))))
             (result (wf-request '((op . "archive") (group . "/work/Inbox")
                                   (id . "mail:archive-root@example.test") (thread . t))))
             (dir (expand-file-name "Maildir/work/Archive/cur" wf-base))
             (files (directory-files dir t "^[^.]") ))
        (should (= (length (alist-get 'moved result)) 2))
        (should (= (alist-get 'failed result) 0))
        (should-not (file-exists-p source))
        (should (= (length files) 2))
        (should (cl-find hash files :key (lambda (f) (with-temp-buffer (insert-file-contents-literally f) (secure-hash 'sha256 (current-buffer)))) :test #'equal))
        (should-not (cl-some (lambda (f) (string-match-p ",U=77" f)) files))
        (should (cl-some (lambda (f) (string-suffix-p ":2,FR" f)) files))
        (should (file-exists-p (expand-file-name "Maildir/second/Inbox/cur/duplicate" wf-base)))
        (should (file-exists-p (expand-file-name "Maildir/work/Sent/cur/sent-relative" wf-base)))
        (let ((read (wf-request '((op . "read") (id . "mail:archive-reply@example.test")))))
          (should (string-match-p "archive reply" (alist-get 'body (alist-get 'message read)))))
        (should (= 0 (length (alist-get 'messages (wf-request '((op . "list") (group . "/work/Inbox"))))))))
    (ef-probe-session-stop)))

(ert-deftest workflow-feed-d-moves-mail-to-trash-and-preserves-failures ()
  (ef-content-state-configure (expand-file-name "trash-state.sqlite3" wf-base))
  (wf-start)
  (let* ((source (concat "maildir:" (expand-file-name "Maildir" wf-base)))
         (entry `((name . "Trash test") (source . ,source) (group . "/trash/Inbox")))
         (original (expand-file-name "Maildir/trash/Inbox/cur/trash-root,U=18:2,FR" wf-base))
         (hash (with-temp-buffer (insert-file-contents-literally original) (secure-hash 'sha256 (current-buffer))))
         (view (get-buffer-create "*workflow trash*")))
    (unwind-protect
        (with-current-buffer view
          (ef-reader-feed-mode)
          (setq ef-reader--entry `((source . ,source) (group . "/missing/Inbox")))
          (ef-reader--set-rows `(((source . ,source) (id . "mail:trash-root@example.test") (author . "Alice") (title . "Still here"))))
          (goto-char (point-min))
          ;; A failed real move leaves the row visible and the source untouched.
          (let ((submit (symbol-function 'camulus-mail-submit)) request)
            (cl-letf (((symbol-function 'camulus-mail-submit)
                       (lambda (data) (setq request (funcall submit data)))))
              (call-interactively (key-binding (kbd "d"))))
            (ef-probe-await (lambda () (wf-finished request)) 15)
            (should (eq (nth 3 (wf-finished request)) 'failed))
            (should (= 1 (hash-table-count ef-reader--rows)))
            (should (file-exists-p original)))
          ;; Use the actual unified-home route, where there is no current group.
          (setq ef-reader--entry nil ef-reader--home t
                ef-reader-home--cursors (make-hash-table :test #'equal))
          (ef-reader-home--begin (list entry) nil)
          (ef-probe-await (lambda () (cl-some (lambda (row) (member "/trash/Inbox" (alist-get 'groups row)))
                                            (hash-table-values ef-reader--rows))) 15)
          (goto-char (point-min))
          (call-interactively (key-binding (kbd "d")))
          (ef-probe-await (lambda () (and (not (file-exists-p original))
                                        (= 0 (hash-table-count ef-reader--rows)))) 20)
          (let* ((dir (expand-file-name "Maildir/trash/Trash/cur" wf-base))
                 (files (directory-files dir t "^[^.]")))
            (should (= 2 (length files)))
            (should (cl-find hash files :test #'equal :key
                             (lambda (f) (with-temp-buffer (insert-file-contents-literally f)
                                                          (secure-hash 'sha256 (current-buffer))))))
            (should (cl-some (lambda (f) (string-suffix-p ":2,FR" f)) files))
            (should-not (cl-some (lambda (f) (string-match-p ",U=18" f)) files))
            (wf-request '((op . "trash") (group . "/trash/Trash")
                          (id . "mail:trash-root@example.test") (thread . t)) t)
            (should (= 2 (length (directory-files dir t "^[^.]")))))
          (should (file-exists-p (expand-file-name "Maildir/trash-other/Inbox/cur/duplicate" wf-base)))
          (should (file-exists-p (expand-file-name "Maildir/trash/Sent/cur/trash-sent" wf-base)))
          (should-not (alist-get 'messages (wf-request '((op . "list") (group . "/trash/Inbox"))))))
      (when (buffer-live-p view) (kill-buffer view))
      (ef-probe-session-stop))))

(ert-deftest workflow-draft-persistence-conflict-and-account-routing ()
  (wf-start)
  (let* ((draft (wf-draft "/second/Inbox")) (key (alist-get 'key draft))
         (revision (alist-get 'revision draft))
         (source (concat (alist-get 'source draft) "未完成草稿\n")))
    (unwind-protect
        (progn
          (should (string-prefix-p "/second/Drafts/" key))
          (should (string-match-p "From: second@example.test" source))
          (wf-request `((op . "draft-save") (key . ,key) (revision . ,revision) (source . ,source)))
          (wf-request `((op . "draft-save") (key . ,key) (revision . ,revision) (source . "stale overwrite")) t)
          (ef-probe-session-stop) (wf-start)
          (let ((opened (alist-get 'draft (wf-request `((op . "draft-open") (key . ,key))))))
            (should (equal source (alist-get 'source opened))))
          (should (cl-find key (alist-get 'drafts (wf-request '((op . "draft-list") (group . "/second/Inbox"))))
                           :key (lambda (d) (alist-get 'key d)) :test #'equal))
          (should (= #o600 (file-modes (concat (expand-file-name "Maildir" wf-base) key)))))
      (ef-probe-session-stop))))

(ert-deftest workflow-draft-autosave-and-window-layout ()
  (wf-start)
  (let (compose right)
    (unwind-protect
        (progn
          (delete-other-windows)
          (switch-to-buffer (get-buffer-create "*workflow summary*"))
          (ef-reader-feed-mode) (setq ef-mail--group "/work/Inbox")
          (setq right (split-window-right))
          (set-window-buffer right (get-buffer-create "*workflow reading*"))
          (ef-mail-compose)
          (ef-probe-await (lambda () (with-current-buffer (window-buffer (selected-window)) ef-mail-draft-key)))
          (setq compose (window-buffer (selected-window)))
          (set-buffer compose)
          (should (eq (window-buffer right) (get-buffer "*workflow reading*")))
          (goto-char (point-max)) (insert "Automatically persisted body\n")
          (ef-probe-await (lambda () (not (buffer-modified-p))) 15)
          (let* ((key ef-mail-draft-key) (data (wf-request `((op . "draft-open") (key . ,key)))))
            (should (string-match-p "Automatically persisted body" (alist-get 'source (alist-get 'draft data)))))
          (insert "Saved when closing\n")
          (kill-buffer compose)
          (should-not (buffer-live-p compose)))
      (when (buffer-live-p compose) (with-current-buffer compose (set-buffer-modified-p nil) (setq ef-mail-draft-error nil)) (kill-buffer compose))
      (dolist (b '("*workflow summary*" "*workflow reading*")) (when (get-buffer b) (kill-buffer b)))
      (delete-other-windows) (ef-probe-session-stop))))

(ert-deftest workflow-sent-copy-and-no-second-submission ()
  (wf-start)
  (unwind-protect
      (let* ((draft (wf-draft "/second/Inbox")) (key (alist-get 'key draft))
             (source (replace-regexp-in-string "^To: $" "To: Test <test@example.test>" (alist-get 'source draft)))
             (source (concat source "A composed message\n"))
             (saved (alist-get 'draft (wf-request `((op . "draft-save") (key . ,key)
                                                   (revision . ,(alist-get 'revision draft)) (source . ,source)))))
             (revision (alist-get 'revision saved))
             (result (wf-request `((op . "draft-send") (key . ,key) (revision . ,revision)))))
        (should (equal (alist-get 'kind result) "draft-sent"))
        (should (alist-get 'cleaned result))
        (should-not (file-exists-p (concat (expand-file-name "Maildir" wf-base) key)))
        (should (= 1 (length (directory-files (expand-file-name "Maildir/second/Sent/cur" wf-base) nil "^[^.]"))))
        (with-temp-buffer
          (insert-file-contents (expand-file-name "sent-envelope.json" wf-base))
          (should (equal "second@example.test" (alist-get 'username (json-parse-buffer :object-type 'alist)))))
        (wf-request `((op . "draft-send") (key . ,key) (revision . ,revision)) t))
    (ef-probe-session-stop)))

(ert-deftest workflow-uncertain-send-survives-restart-without-replay ()
  (let (key revision)
    (cl-labels ((start ()
                  (ef-mail-configure (expand-file-name "Maildir" wf-base) (expand-file-name "mu" wf-base)
                                     "work@example.test" (executable-find "mu")
                                     "work")
                  (ef-test-smtp wf-base "work" "work@example.test" "SMTP_FAIL_PORT")
                  (ef-probe-session-start)))
      (start)
      (unwind-protect
          (let* ((d (wf-draft "/work/Inbox"))
                 (source (replace-regexp-in-string "^To: $" "To: test@example.test" (alist-get 'source d)))
                 (saved (alist-get 'draft (wf-request `((op . "draft-save") (key . ,(alist-get 'key d))
                                                       (revision . ,(alist-get 'revision d)) (source . ,source))))))
            (setq key (alist-get 'key saved) revision (alist-get 'revision saved))
            (wf-request `((op . "draft-send") (key . ,key) (revision . ,revision)) t)
            (should (file-exists-p (concat (expand-file-name "Maildir" wf-base) key)))
            (let ((count (with-temp-buffer (insert-file-contents (expand-file-name "failed-send-count" wf-base)) (buffer-string))))
              (ef-probe-session-stop) (start)
              (wf-request `((op . "draft-send") (key . ,key) (revision . ,revision)) t)
              (should (equal count (with-temp-buffer (insert-file-contents (expand-file-name "failed-send-count" wf-base)) (buffer-string))))))
        (ef-probe-session-stop)))))
(ert-run-tests-batch-and-exit)
