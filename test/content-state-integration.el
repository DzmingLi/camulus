;;; content-state-integration.el --- Synthetic persistent reader workflows -*- lexical-binding: t; -*-
(require 'ert)
(require 'camulus)
(setq ef-probe-record-events t)
(defvar ef-state-test-base (getenv "MAIL_FIXTURE"))
(unless ef-state-test-base (error "MAIL_FIXTURE is required"))
(defun ef-state-test-finished (id)
  (cl-find-if (lambda (e) (and (eq (car e) 'finished) (= (cadr e) id))) ef-probe--events))
(defun ef-state-test-await (id)
  (ef-probe-await (lambda () (ef-state-test-finished id)) 30)
  (let ((event (ef-state-test-finished id)))
    (unless (eq (nth 3 event) 'completed) (error "State failed: %S" event))))
(defun ef-state-test-request (request)
  (let ((id (camulus-state-submit request)))
    (ef-state-test-await id)
    (mapcar (lambda (event) (nth 3 event))
            (reverse (cl-remove-if-not (lambda (e) (and (eq (car e) 'content-state) (= (cadr e) id))) ef-probe--events)))))
(defun ef-state-test-result (request kind)
  (cl-find kind (ef-state-test-request request) :key (lambda (x) (alist-get 'kind x)) :test #'equal))
(defun ef-state-test-ui-idle ()
  (ef-probe-await (lambda () (= 0 (hash-table-count ef-reader--requests))) 30))
(defmacro ef-state-test-session (&rest body)
  `(let* ((directory (make-temp-file "reader-state-test" t))
          (ef-reader-config-file (expand-file-name "config.json" directory))
          (ef-reader-groups-file (expand-file-name "groups.json" directory))
          (camulus-group-subscriptions-file (expand-file-name "group-subscriptions.json" directory))
          (ef-reader-rss-subscriptions-file (expand-file-name "rss-subscriptions.json" directory))
          (ef-reader-entries nil)
          (ef-reader-state-file (expand-file-name "state.sqlite3" directory))
          (ef-mail-root (expand-file-name "Maildir" ef-state-test-base))
          (ef-mail-muhome (expand-file-name "mu" ef-state-test-base))
          (ef-mail-sender "bob@example.test")
          (ef-mail-smtp-profiles nil) (ef-mail-accounts nil)
          (source (concat "maildir:" ef-mail-root))
          (ef-reader-entries (list (list (cons 'name "Home") (cons 'source source) (cons 'group "/Inbox"))))
         )
     (ef-reader-start)
     (unwind-protect (progn ,@body)
       (dolist (buffer (buffer-list))
         (with-current-buffer buffer
           (when (derived-mode-p 'ef-reader-feed-mode 'ef-reader-folder-mode 'ef-reader-article-mode)
             (kill-buffer buffer))))
       (ef-probe-session-stop)
       (ef-content-state-configure "")
       (delete-directory directory t))))

(ert-deftest state-feed-dismiss-survives-restart-without-changing-read-or-subscription ()
  (ef-state-test-session
   (let* ((feed (ef-state-test-result `((op . "refresh") (source . ,source) (group . ,"/Inbox")) "feed"))
          (rows (alist-get 'rows feed)) (row (car rows)))
     (should (= 3 (length rows)))
     (ef-state-test-request `((op . "dismiss") (group . ,"/Inbox") (source . ,source) (id . ,(alist-get 'id row))
                             (revision . ,(alist-get 'revision row))))
     (should (= 2 (length (alist-get 'rows (ef-state-test-result `((op . "refresh") (source . ,source) (group . ,"/Inbox")) "feed")))))
     (ef-probe-session-stop) (ef-reader-start)
     (should (= 2 (length (alist-get 'rows (ef-state-test-result `((op . "feed") (source . ,source) (group . ,"/Inbox")) "feed")))))
     (let* ((result (ef-state-test-result `((op . "states") (source . ,source) (ids . [,(alist-get 'id row)])) "states"))
            (item (car (alist-get 'items (alist-get 'data result)))))
       (should-not (alist-get 'read item))))))

(ert-deftest state-home-keys-folder-picker-and-offline-mime-archive ()
  (ef-state-test-session
   (save-window-excursion
     (ef-state-test-request `((op . "refresh") (source . ,source) (group . ,"/Inbox")))
     (camulus (car ef-reader-entries)) (ef-state-test-ui-idle)
     (should (eq major-mode 'ef-reader-feed-mode))
     (should (eq (key-binding "d") #'ef-reader-delete))
     (should (eq (key-binding "m") #'ef-reader-save))
     (should (memq (key-binding "k") '(nil undefined)))
     (goto-char (point-min))
     (search-forward "Re: 测试主题")
     (cl-letf (((symbol-function 'completing-read)
                (lambda (prompt choices &rest _)
                  (should (string-match-p "folder" prompt))
                  (should-not choices) "work/mail")))
       (ef-reader-save) (ef-state-test-ui-idle))
     (let ((rows (alist-get 'rows (ef-state-test-result '((op . "favorites") (folder . "work/mail")) "favorites"))))
       (should (= 1 (length rows)))
       (let ((id (alist-get 'id (car rows))) part)
         (ef-probe-session-stop)
         ;; No mail backend access can succeed after this point.
         (ef-mail-configure ef-mail-root ef-mail-muhome ef-mail-sender "/nonexistent/mu" "")
         (ef-probe-session-start)
         (ef-state-test-request `((op . "favorite") (source . ,source) (target . "thread") (id . ,id) (folder . "keep")))
         (let ((data (ef-state-test-result `((op . "archive") (source . ,source) (target . "thread") (id . ,id)) "archive")))
           (should (= 3 (length (alist-get 'articles data))))
           (let ((root (cl-find "mail:root@example.test" (alist-get 'articles data)
                                :test #'equal :key (lambda (a) (alist-get 'id (alist-get 'message a))))))
             (should (string-match-p "root body" (alist-get 'body (alist-get 'message root))))
             (setq part (alist-get 'part (car (alist-get 'attachments root))))))
         (with-current-buffer (get-buffer-create "*Reader folder: keep*")
           (ef-reader-folder-mode) (setq ef-reader--folder "keep")
           (ef-reader--load-list))
         (ef-state-test-ui-idle)
         (with-current-buffer "*Reader folder: keep*"
           (goto-char (point-min)) (ef-reader-open))
         (ef-state-test-ui-idle)
         (with-current-buffer "*Reader thread*"
           (should (string-match-p "root body" (buffer-string)))
           (should (string-match-p "Save ../附件.bin" (buffer-string)))
           (should ef-reader--archive))
         (ef-state-test-request '((op . "remove-folder") (folder . "work")))
         (should (= 1 (length (alist-get 'rows (ef-state-test-result '((op . "favorites") (folder . "keep")) "favorites")))))
         (let ((destination (expand-file-name "attachment.bin" directory)))
           (ef-state-test-request `((op . "attachment") (source . ,source) (id . "mail:root@example.test")
                                   (part . ,part) (destination . ,destination)))
           (with-temp-buffer
             (set-buffer-multibyte nil) (insert-file-contents-literally destination)
             (should (equal (buffer-string) "attachment\0bytes\n")))))))))

(ert-deftest state-read-only-visible-loaded-messages-and-first-unread ()
  (ef-state-test-session
   (let ((id (camulus-mail-submit '((op . "thread") (id . "mail:root@example.test")))))
     (ef-state-test-await id))
   (ef-state-test-request `((op . "read") (source . ,source) (ids . ["mail:root@example.test"]) (value . t)))
   (with-temp-buffer
     (ef-reader-article-mode)
     (setq ef-reader--source source)
     (dolist (m '(((id . "mail:root@example.test") (author . "root") (title . "Root") (body . "root") (created . 1))
                  ((id . "mail:reply@example.test") (parent_id . "mail:root@example.test") (author . "reply") (title . "Reply") (body . "reply") (created . 2))
                  ((id . "mail:child@example.test") (parent_id . "mail:reply@example.test") (author . "child") (title . "Child") (body . "child") (created . 3))))
       (puthash (alist-get 'id m) m ef-reader--messages))
     (puthash "mail:root@example.test" t ef-reader--loaded)
     (puthash "mail:reply@example.test" t ef-reader--loaded)
     (ef-reader--render)
     (should (equal (get-text-property (point) 'ef-reader-id) "mail:reply@example.test"))
     (let ((first (point)) (end (point-max)))
       (cl-letf (((symbol-function 'get-buffer-window-list) (lambda (&rest _) '(fake-window)))
                 ((symbol-function 'window-start) (lambda (_) first))
                 ((symbol-function 'window-end) (lambda (&rest _) end))
                 ((symbol-function 'pos-visible-in-window-p) (lambda (&rest _) t)))
         (ef-reader--mark-visible (current-buffer))))
     (ef-state-test-ui-idle)
     (should (alist-get 'read (ef-reader--state source "mail:reply@example.test")))
     (should-not (alist-get 'read (ef-reader--state source "mail:child@example.test"))))
   (ef-probe-session-stop) (ef-reader-start)
   (let* ((data (ef-state-test-result `((op . "states") (source . ,source) (ids . ["mail:reply@example.test"])) "states")))
     (should (alist-get 'read (car (alist-get 'items (alist-get 'data data))))))))

(ert-run-tests-batch-and-exit)
