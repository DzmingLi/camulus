;;; content-state-integration.el --- Synthetic persistent reader workflows -*- lexical-binding: t; -*-
(require 'ert)
(require 'camulus)
(setq camulus-probe-record-events t)
(defvar camulus-state-test-base (getenv "MAIL_FIXTURE"))
(unless camulus-state-test-base (error "MAIL_FIXTURE is required"))
(defun camulus-state-test-finished (id)
  (cl-find-if (lambda (e) (and (eq (car e) 'finished) (= (cadr e) id))) camulus-probe--events))
(defun camulus-state-test-await (id)
  (camulus-probe-await (lambda () (camulus-state-test-finished id)) 30)
  (let ((event (camulus-state-test-finished id)))
    (unless (eq (nth 3 event) 'completed) (error "State failed: %S" event))))
(defun camulus-state-test-request (request)
  (let ((id (camulus-state-submit request)))
    (camulus-state-test-await id)
    (mapcar (lambda (event) (nth 3 event))
            (reverse (cl-remove-if-not (lambda (e) (and (eq (car e) 'content-state) (= (cadr e) id))) camulus-probe--events)))))
(defun camulus-state-test-result (request kind)
  (cl-find kind (camulus-state-test-request request) :key (lambda (x) (alist-get 'kind x)) :test #'equal))
(defun camulus-state-test-ui-idle ()
  (camulus-probe-await (lambda () (= 0 (hash-table-count camulus-reader--requests))) 30))
(defmacro camulus-state-test-session (&rest body)
  `(let* ((directory (make-temp-file "reader-state-test" t))
          (camulus-reader-config-file (expand-file-name "config.json" directory))
          (camulus-reader-groups-file (expand-file-name "groups.json" directory))
          (camulus-group-subscriptions-file (expand-file-name "group-subscriptions.json" directory))
          (camulus-reader-rss-subscriptions-file (expand-file-name "rss-subscriptions.json" directory))
          (camulus-groups nil)
          (camulus-state-file (expand-file-name "state.sqlite3" directory))
          (camulus-mail-root (expand-file-name "Maildir" camulus-state-test-base))
          (camulus-mail-muhome (expand-file-name "mu" camulus-state-test-base))
          (camulus-mail-sender "bob@example.test")
          (camulus-mail-smtp-profiles nil) (camulus-mail-accounts nil)
          (source (concat "maildir:" camulus-mail-root))
          (camulus-groups (list (list (cons 'name "Home") (cons 'source source) (cons 'group "/Inbox"))))
         )
     (camulus-reader-start)
     (unwind-protect (progn ,@body)
       (dolist (buffer (buffer-list))
         (with-current-buffer buffer
           (when (derived-mode-p 'camulus-reader-feed-mode 'camulus-reader-folder-mode 'camulus-reader-article-mode)
             (kill-buffer buffer))))
       (camulus-probe-session-stop)
       (camulus-content-state-configure "")
       (delete-directory directory t))))

(ert-deftest state-feed-dismiss-survives-restart-without-changing-read-or-subscription ()
  (camulus-state-test-session
   (let* ((feed (camulus-state-test-result `((op . "refresh") (source . ,source) (group . ,"/Inbox")) "feed"))
          (rows (alist-get 'rows feed)) (row (car rows)))
     (should (= 3 (length rows)))
     (camulus-state-test-request `((op . "dismiss") (group . ,"/Inbox") (source . ,source) (id . ,(alist-get 'id row))
                             (revision . ,(alist-get 'revision row))))
     (should (= 2 (length (alist-get 'rows (camulus-state-test-result `((op . "refresh") (source . ,source) (group . ,"/Inbox")) "feed")))))
     (camulus-probe-session-stop) (camulus-reader-start)
     (should (= 2 (length (alist-get 'rows (camulus-state-test-result `((op . "feed") (source . ,source) (group . ,"/Inbox")) "feed")))))
     (let* ((result (camulus-state-test-result `((op . "states") (source . ,source) (ids . [,(alist-get 'id row)])) "states"))
            (item (car (alist-get 'items (alist-get 'data result)))))
       (should-not (alist-get 'read item))))))

(ert-deftest state-home-keys-folder-picker-and-offline-mime-archive ()
  (camulus-state-test-session
   (save-window-excursion
     (camulus-state-test-request `((op . "refresh") (source . ,source) (group . ,"/Inbox")))
     (camulus (car camulus-groups)) (camulus-state-test-ui-idle)
     (should (eq major-mode 'camulus-reader-feed-mode))
     (should (eq (key-binding "d") #'camulus-reader-delete))
     (should (eq (key-binding "m") #'camulus-reader-save))
     (should (memq (key-binding "k") '(nil undefined)))
     (goto-char (point-min))
     (search-forward "Re: 测试主题")
     (cl-letf (((symbol-function 'completing-read)
                (lambda (prompt choices &rest _)
                  (should (string-match-p "folder" prompt))
                  (should-not choices) "work/mail")))
       (camulus-reader-save) (camulus-state-test-ui-idle))
     (let ((rows (alist-get 'rows (camulus-state-test-result '((op . "favorites") (folder . "work/mail")) "favorites"))))
       (should (= 1 (length rows)))
       (let ((id (alist-get 'id (car rows))) part)
         (camulus-probe-session-stop)
         ;; No mail backend access can succeed after this point.
         (camulus-mail-configure camulus-mail-root camulus-mail-muhome camulus-mail-sender "/nonexistent/mu" "")
         (camulus-probe-session-start)
         (camulus-state-test-request `((op . "favorite") (source . ,source) (target . "thread") (id . ,id) (folder . "keep")))
         ;; Choosing another folder reuses the offline archive and is idempotent.
         (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "another")))
           (should (eq (key-binding "m") #'camulus-reader-save))
           (call-interactively (key-binding "m")) (camulus-state-test-ui-idle)
           (call-interactively (key-binding "m")) (camulus-state-test-ui-idle))
         (should (= 1 (length (alist-get 'rows (camulus-state-test-result '((op . "favorites") (folder . "another")) "favorites")))))
         (let ((data (camulus-state-test-result `((op . "archive") (source . ,source) (target . "thread") (id . ,id)) "archive")))
           (should (= 3 (length (alist-get 'articles data))))
           (let ((root (cl-find "mail:root@example.test" (alist-get 'articles data)
                                :test #'equal :key (lambda (a) (alist-get 'id (alist-get 'message a))))))
             (should (string-match-p "root body" (alist-get 'body (alist-get 'message root))))
             (setq part (alist-get 'part (car (alist-get 'attachments root))))))
         (with-current-buffer (get-buffer-create "*Reader folder: keep*")
           (camulus-reader-folder-mode) (setq camulus-reader--folder "keep")
           (camulus-reader--load-list))
         (camulus-state-test-ui-idle)
         (with-current-buffer "*Reader folder: keep*"
           (goto-char (point-min)) (camulus-reader-open))
         (camulus-state-test-ui-idle)
         (with-current-buffer "*Reader thread*"
           (should (string-match-p "root body" (buffer-string)))
           (should-not (string-match-p "Save .*附件.bin" (buffer-string)))
           (goto-char (point-min))
           (camulus-mail-attachments)
           (with-current-buffer "*Camulus mail attachments*"
             (should (equal (aref (cadar tabulated-list-entries) 0) "附件.bin"))
             (camulus-mail-attachments-close))
           (should camulus-reader--archive))
         (let ((article (get-buffer-window "*Reader thread*"))
               (summary (get-buffer-window "*Reader*")))
           (should article) (should summary)
           (select-window article)
           (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) (ert-fail "f prompted for a folder"))))
             (call-interactively (key-binding "f")) (camulus-state-test-ui-idle))
           (should (eq (selected-window) summary))
           (should (eq (window-buffer article) (get-buffer "*Reader thread*")))
           (should (eq major-mode 'camulus-reader-folders-mode))
           (goto-char (point-min)) (search-forward "keep")
           (button-activate (button-at (1- (point)))) (camulus-state-test-ui-idle)
           (should (equal camulus-reader--folder "keep"))
           (should (= 1 (length tabulated-list-entries))))
         (camulus-state-test-request '((op . "remove-folder") (folder . "work")))
         (should (= 1 (length (alist-get 'rows (camulus-state-test-result '((op . "favorites") (folder . "keep")) "favorites")))))
         (let ((destination (expand-file-name "attachment.bin" directory)))
           (camulus-state-test-request `((op . "attachment") (source . ,source) (id . "mail:root@example.test")
                                   (part . ,part) (destination . ,destination)))
           (with-temp-buffer
             (set-buffer-multibyte nil) (insert-file-contents-literally destination)
             (should (equal (buffer-string) "attachment\0bytes\n")))))))))

(ert-deftest state-read-only-visible-loaded-messages-and-first-unread ()
  (camulus-state-test-session
   (let ((id (camulus-mail-submit '((op . "thread") (id . "mail:root@example.test")))))
     (camulus-state-test-await id))
   (camulus-state-test-request `((op . "read") (source . ,source) (ids . ["mail:root@example.test"]) (value . t)))
   (with-temp-buffer
     (camulus-reader-article-mode)
     (setq camulus-reader--source source)
     (dolist (m '(((id . "mail:root@example.test") (author . "root") (title . "Root") (body . "root") (created . 1))
                  ((id . "mail:reply@example.test") (parent_id . "mail:root@example.test") (author . "reply") (title . "Reply") (body . "reply") (created . 2))
                  ((id . "mail:child@example.test") (parent_id . "mail:reply@example.test") (author . "child") (title . "Child") (body . "child") (created . 3))))
       (puthash (alist-get 'id m) m camulus-reader--messages))
     (puthash "mail:root@example.test" t camulus-reader--loaded)
     (puthash "mail:reply@example.test" t camulus-reader--loaded)
     (camulus-reader--render)
     (should (equal (get-text-property (point) 'camulus-reader-id) "mail:reply@example.test"))
     (let ((first (point)) (end (point-max)))
       (cl-letf (((symbol-function 'get-buffer-window-list) (lambda (&rest _) '(fake-window)))
                 ((symbol-function 'window-start) (lambda (_) first))
                 ((symbol-function 'window-end) (lambda (&rest _) end))
                 ((symbol-function 'pos-visible-in-window-p) (lambda (&rest _) t)))
         (camulus-reader--mark-visible (current-buffer))))
     (camulus-state-test-ui-idle)
     (should (alist-get 'read (camulus-reader--state source "mail:reply@example.test")))
     (should-not (alist-get 'read (camulus-reader--state source "mail:child@example.test"))))
   (camulus-probe-session-stop) (camulus-reader-start)
   (let* ((data (camulus-state-test-result `((op . "states") (source . ,source) (ids . ["mail:reply@example.test"])) "states")))
     (should (alist-get 'read (car (alist-get 'items (alist-get 'data data))))))))

(ert-deftest state-favorites-turn-red-and-return-to-read-gray-after-last-removal ()
  (camulus-state-test-session
   (save-window-excursion
     (camulus-state-test-request `((op . "refresh") (source . ,source) (group . "/Inbox")))
     (camulus-state-test-await (camulus-mail-submit '((op . "thread") (id . "mail:root@example.test"))))
     (camulus-state-test-request `((op . "read") (source . ,source)
                             (ids . ["mail:root@example.test" "mail:reply@example.test" "mail:child@example.test"]) (value . t)))
     (camulus (car camulus-groups)) (camulus-state-test-ui-idle)
     (should (= 3 (length tabulated-list-entries)))
     (goto-char (point-min)) (search-forward "Re: 测试主题") (beginning-of-line)
     (let ((id (alist-get 'id (camulus-reader--selected))) (key (tabulated-list-get-id)))
       (cl-labels ((face () (ensure-list (get-text-property 0 'face (aref (cadr (assoc key tabulated-list-entries)) 3)))))
         (should (memq 'camulus-reader-read (face)))
         (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "chosen")))
           (camulus-reader-save) (camulus-state-test-ui-idle))
         (should (memq 'camulus-reader-favorite (face)))
         (should-not (memq 'camulus-reader-read (face)))
         (camulus-state-test-request `((op . "favorite") (source . ,source) (id . ,id) (target . "thread") (folder . "other")))
         (camulus-state-test-request `((op . "unfavorite") (source . ,source) (id . ,id) (target . "thread") (folder . "chosen")))
         (camulus-state-test-ui-idle)
         (should (memq 'camulus-reader-favorite (face)))
         (camulus-state-test-request `((op . "remove-folder") (folder . "other")))
         (camulus-state-test-ui-idle)
         (should (memq 'camulus-reader-read (face)))
         (should-not (memq 'camulus-reader-favorite (face)))
         (should (= 3 (length tabulated-list-entries))))))))

(ert-run-tests-batch-and-exit)
