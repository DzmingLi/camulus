;;; rss-integration.el --- Native RSS/Atom workflows -*- lexical-binding: t; -*-
(require 'ert)
(require 'camulus)
(setq camulus-probe-record-events t)
(require 'url)
(defvar camulus-rss-test-base (or (getenv "RSS_FIXTURE") (error "RSS_FIXTURE required")))
(defun camulus-rss-test-control (mode)
  (let ((url-proxy-services nil))
    (kill-buffer (url-retrieve-synchronously (concat camulus-rss-test-base "/control/" mode) t t 5))))
(defun camulus-rss-test-finished (id)
  (cl-find-if (lambda (e) (and (eq (car e) 'finished) (= (cadr e) id))) camulus-probe--events))
(defun camulus-rss-test-await (id)
  (camulus-probe-await (lambda () (camulus-rss-test-finished id)) 15)
  (should (eq (nth 3 (camulus-rss-test-finished id)) 'completed)))
(defun camulus-rss-test-state (request kind)
  (let ((id (camulus-state-submit request)))
    (camulus-rss-test-await id)
    (cl-find kind
             (mapcar (lambda (e) (nth 3 e))
                     (cl-remove-if-not (lambda (e) (and (eq (car e) 'content-state) (= (cadr e) id))) camulus-probe--events))
             :key (lambda (data) (alist-get 'kind data)) :test #'equal)))

(defun camulus-rss-test-idle ()
  (camulus-probe-await (lambda () (and (= 0 (hash-table-count camulus-reader--requests))
                                (= 0 (hash-table-count camulus-reader--loads)))) 15))
(defmacro camulus-rss-test-session (&rest body)
  `(let* ((directory (make-temp-file "rss-reader" t))
          (camulus-reader-config-file (expand-file-name "config.json" directory))
          (camulus-reader-groups-file (expand-file-name "groups.json" directory))



          (camulus-rss-subscriptions nil) (camulus-jsonfeed-subscriptions nil)
          (camulus-groups nil)
          (camulus-state-file (expand-file-name "state.sqlite" directory))
          (camulus-mail-sender nil) (camulus-reddit-username nil)
          (url (concat camulus-rss-test-base "/redirect"))
          (source (concat "rss:" url))
          (camulus-groups (list (list (cons 'name "Home") (cons 'source source) (cons 'group url))))
         )
     (camulus-rss-test-control "online")
     (camulus-reader-start)
     (unwind-protect (save-window-excursion ,@body)
       (dolist (buffer (buffer-list))
         (with-current-buffer buffer
           (when (derived-mode-p 'camulus-reader-feed-mode 'camulus-reader-folder-mode 'camulus-reader-article-mode 'camulus-reader-rss-mode)
             (kill-buffer buffer))))
       (camulus-probe-session-stop)
       (camulus-content-state-configure "")
       (delete-directory directory t))))

(ert-deftest rss-home-subscribe-read-favorite-and-offline-enclosure ()
  (camulus-rss-test-session
   (camulus (car camulus-groups)) (camulus-rss-test-idle)
   (setopt camulus-rss-subscriptions (list url))
   (camulus-rss-test-idle)
   (camulus-reader-refresh) (camulus-rss-test-idle)
   (should (= 1 (length tabulated-list-entries)))
   (goto-char (point-min))
   (should (equal (alist-get 'target (camulus-reader--selected)) "article"))
   (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "reading/blogs")))
     (camulus-reader-save) (camulus-rss-test-idle))
   (let ((rows (alist-get 'rows (camulus-rss-test-state '((op . "favorites") (folder . "reading/blogs")) "favorites"))))
     (should (equal (alist-get 'target (car rows)) "article")))
   (let ((summary (selected-window)))
     (camulus-reader-open) (camulus-rss-test-idle)
     (should (eq major-mode 'camulus-reader-article-mode))
     (should-not (eq summary (selected-window)))
     (should (> (car (window-edges)) (car (window-edges summary)))))
   (with-current-buffer "*Reader thread*"
     (should (string-match-p "RSS body version 1" (buffer-string)))
     (should (string-match-p "Save file.bin" (buffer-string)))
     (should camulus-reader--complete))
   (with-current-buffer "*Reader*"
     (goto-char (point-min)) (camulus-reader-delete))
   (camulus-rss-test-idle)
   (should-not (alist-get 'rows (camulus-rss-test-state `((op . "refresh") (source . ,source) (group . ,url)) "feed")))
   (camulus-rss-test-control "update")
   (should (= 1 (length (alist-get 'rows (camulus-rss-test-state `((op . "refresh") (source . ,source) (group . ,url)) "feed")))))
   (camulus-rss-test-state '((op . "refresh-archives")) "archives-refreshed")
   (camulus-probe-session-stop) (camulus-reader-start)
   (camulus-rss-test-control "offline")
   (with-current-buffer (get-buffer-create "*RSS saved*")
     (camulus-reader-folder-mode) (setq camulus-reader--folder "reading/blogs")
     (camulus-reader--load-list))
   (camulus-rss-test-idle)
   (with-current-buffer "*RSS saved*" (goto-char (point-min)) (camulus-reader-open))
   (camulus-rss-test-idle)
   (with-current-buffer "*Reader thread*"
     (should (string-match-p "RSS body version 2" (buffer-string)))
     (should camulus-reader--archive))
   (let ((destination (expand-file-name "saved.bin" directory)))
     (camulus-rss-test-state `((op . "attachment") (source . ,source) (id . "rss:one") (part . 0)
                         (destination . ,destination)) "saved")
     (with-temp-buffer
       (set-buffer-multibyte nil) (insert-file-contents-literally destination)
       (should (equal (buffer-string) (unibyte-string 82 83 83 0 97 116 116 97 99 104 109 101 110 116 255 10)))))))

(ert-deftest atom-browse-live-enclosure-without-subscription ()
  (camulus-rss-test-session
   (setq url (concat camulus-rss-test-base "/atom"))
   (camulus-reader-rss url) (camulus-rss-test-idle)
   (should (= 1 (length tabulated-list-entries)))
   (should-not (alist-get 'rows (camulus-rss-test-state `((op . "feed") (source . ,source) (group . ,url)) "feed")))
   (goto-char (point-min)) (camulus-reader-open) (camulus-rss-test-idle)
   (with-current-buffer "*Reader thread*"
     (should (string-match-p "Atom plain <b>text</b>" (buffer-string))))
   (let ((destination (expand-file-name "live.bin" directory)))
     (with-current-buffer "*Reader thread*"
       (goto-char (point-min)) (search-forward "Save file.bin")
       (cl-letf (((symbol-function 'read-file-name) (lambda (&rest _) destination)))
         (button-activate (button-at (1- (point))))))
     (camulus-rss-test-idle)
     (should (= 16 (file-attribute-size (file-attributes destination)))))))

(ert-deftest rss-slow-http-is-cancellable-and-does-not-block-worker ()
  (camulus-rss-test-session
   (let* ((slow (camulus-rss-submit `((op . "list") (url . ,(concat camulus-rss-test-base "/slow")))))
          (other (camulus-probe-submit 10 1 t nil 0)))
     (camulus-rss-test-await other)
     (should-not (camulus-rss-test-finished slow))
     (should (camulus-probe-cancel slow))
     (camulus-probe-await (lambda () (camulus-rss-test-finished slow)) 3)
     (should (eq (nth 3 (camulus-rss-test-finished slow)) 'cancelled)))))

(ert-deftest rss-unified-home-discovers-feeds-and-retains-cache-on-failure ()
  (camulus-rss-test-session
   (let* ((atom (concat camulus-rss-test-base "/atom"))
          (missing (concat camulus-rss-test-base "/missing"))
          (camulus-groups (append camulus-groups
                                     '(((name . "Unavailable") (source . "not-configured") (group . "inbox") )
                                       ((name . "Browse only") (source . "not-configured") (group . "browse"))))))
     (setopt camulus-rss-subscriptions (list url atom missing))
     (camulus) (camulus-rss-test-idle)
     (should camulus-reader--home)
     (should (= 3 (length camulus-reader-home--entries)))
     (should (= 2 (length tabulated-list-entries)))
     (should (= 1 (length camulus-reader-home--errors)))
     (should (string-prefix-p "Home" (apply #'concat header-line-format)))
     (should-not (fboundp 'camulus-reader-search))
     (goto-char (point-min))
     (let* ((selected (camulus-reader--selected)) (selected-source (alist-get 'source selected))
            (entry (camulus-reader-home-row-entry selected)))
       (should entry)
       (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "home/saved")))
         (camulus-reader-save) (camulus-rss-test-idle))
       (should (= 1 (length (alist-get 'rows (camulus-rss-test-state '((op . "favorites") (folder . "home/saved")) "favorites")))))
       (camulus-reader-delete) (camulus-rss-test-idle)
       (should (= 1 (length tabulated-list-entries)))
       (should (= 1 (length (alist-get 'rows (camulus-rss-test-state
                     `((op . "feed") (source . ,selected-source) (group . ,(alist-get 'group entry))) "feed")))))
       (camulus-reader-refresh) (camulus-rss-test-idle)
       (should (= 1 (length tabulated-list-entries))))
     ;; Failed refresh leaves the visible cached row available for reading.
     (camulus-rss-test-control "offline")
     (camulus-reader-refresh) (camulus-rss-test-idle)
     (should (= 1 (length tabulated-list-entries)))
     (should (>= (length camulus-reader-home--errors) 2))
     ;; Removing a backend subscription removes membership on the next refresh.
     (setopt camulus-rss-subscriptions nil)
     (camulus-reader-refresh) (camulus-rss-test-idle)
     (should-not tabulated-list-entries))))

(ert-deftest rss-home-priorities-filter-sources-without-unsubscribing ()
  (camulus-rss-test-session
   (let* ((atom-url (concat camulus-rss-test-base "/atom"))
          (atom-source (concat "rss:" atom-url))
          (atom-entry `((name . "Low priority Atom") (source . ,atom-source) (group . ,atom-url)))
          (camulus-groups (append camulus-groups (list atom-entry)))
          (camulus-default-subscription-priority 2)
          (camulus-subscription-priorities (list (list source url 1) (list atom-source atom-url 3)))
          (camulus-home-priorities '(1))
          (custom-file (expand-file-name "custom.el" directory))
          (user-init-file (expand-file-name "init.el" directory)))
     (setopt camulus-rss-subscriptions (list url atom-url))
     (camulus) (camulus-rss-test-idle)
     (should (= 1 (length camulus-reader-home--entries)))
     (should (equal source (alist-get 'source (car camulus-reader-home--entries))))
     (should (= 1 (length tabulated-list-entries)))
     (should (equal "rss:one" (alist-get 'id (camulus-reader--selected))))
     ;; The excluded source remains browsable and subscribed.
     (camulus-reader-browse-entry atom-entry) (camulus-rss-test-idle)
     (should (= 1 (length tabulated-list-entries)))
     (camulus-subscriptions)
     (camulus-probe-await (lambda () (= 0 camulus-reader-subscriptions--pending)) 10)
     (should (= 2 (length camulus-reader-subscriptions--entries)))
     (goto-char (point-min)) (search-forward "Low priority Atom")
     (should (string-match-p "priority 3" (buffer-string)))
     (cl-letf (((symbol-function 'read-number) (lambda (&rest _) 1)))
       (camulus-subscription-set-priority))
     (camulus-rss-test-idle)
     (should (file-exists-p custom-file))
     (should (equal (assoc atom-source camulus-subscription-priorities) (list atom-source atom-url 1)))
     (camulus) (camulus-rss-test-idle)
     (should (= 2 (length tabulated-list-entries)))
     ;; Empty selection shows all; the priority filter does not write dismissals.
     (cl-letf (((symbol-function 'completing-read-multiple) (lambda (&rest _) nil)))
       (camulus-home-select-priorities))
     (camulus-rss-test-idle)
     (should-not camulus-home-priorities)
     (should (= 2 (length camulus-reader-home--entries)))
     (should (= 2 (length camulus-groups)))
     (kill-buffer "*Camulus subscriptions*"))))

(unless (bound-and-true-p camulus-test-loading-helpers) (ert-run-tests-batch-and-exit))
