;;; rss-integration.el --- Native RSS/Atom workflows -*- lexical-binding: t; -*-
(require 'ert)
(require 'camulus)
(setq ef-probe-record-events t)
(require 'url)
(defvar ef-rss-test-base (or (getenv "RSS_FIXTURE") (error "RSS_FIXTURE required")))
(defun ef-rss-test-control (mode)
  (let ((url-proxy-services nil))
    (kill-buffer (url-retrieve-synchronously (concat ef-rss-test-base "/control/" mode) t t 5))))
(defun ef-rss-test-finished (id)
  (cl-find-if (lambda (e) (and (eq (car e) 'finished) (= (cadr e) id))) ef-probe--events))
(defun ef-rss-test-await (id)
  (ef-probe-await (lambda () (ef-rss-test-finished id)) 15)
  (should (eq (nth 3 (ef-rss-test-finished id)) 'completed)))
(defun ef-rss-test-state (request kind)
  (let ((id (camulus-state-submit request)))
    (ef-rss-test-await id)
    (cl-find kind
             (mapcar (lambda (e) (nth 3 e))
                     (cl-remove-if-not (lambda (e) (and (eq (car e) 'content-state) (= (cadr e) id))) ef-probe--events))
             :key (lambda (data) (alist-get 'kind data)) :test #'equal)))

(defun ef-rss-test-idle ()
  (ef-probe-await (lambda () (and (= 0 (hash-table-count ef-reader--requests))
                                (= 0 (hash-table-count ef-reader--loads)))) 15))
(defmacro ef-rss-test-session (&rest body)
  `(let* ((directory (make-temp-file "rss-reader" t))
          (ef-reader-config-file (expand-file-name "entries.json" directory))
          (ef-reader-rss-subscriptions-file (expand-file-name "rss-subscriptions.json" directory))
          (camulus-jsonfeed-subscriptions-file (expand-file-name "jsonfeed-subscriptions.json" directory))
          (ef-reader-entries nil) (ef-reader-home nil)
          (ef-reader-state-file (expand-file-name "state.sqlite" directory))
          (ef-mail-sender nil) (ef-reddit-username nil)
          (url (concat ef-rss-test-base "/redirect"))
          (source (concat "rss:" url))
          (ef-reader-entries (list (list (cons 'name "Home") (cons 'source source) (cons 'group url))))
          (ef-reader-home "Home"))
     (ef-rss-test-control "online")
     (ef-reader-start)
     (unwind-protect (save-window-excursion ,@body)
       (dolist (buffer (buffer-list))
         (with-current-buffer buffer
           (when (derived-mode-p 'ef-reader-feed-mode 'ef-reader-folder-mode 'ef-reader-article-mode 'ef-reader-rss-mode)
             (kill-buffer buffer))))
       (ef-probe-session-stop)
       (ef-content-state-configure "")
       (delete-directory directory t))))

(ert-deftest rss-home-subscribe-read-favorite-and-offline-enclosure ()
  (ef-rss-test-session
   (camulus (car ef-reader-entries)) (ef-rss-test-idle)
   (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "subscribed")))
     (ef-reader-subscription) (ef-rss-test-idle))
   (ef-rss-test-idle)
   (ef-reader-refresh) (ef-rss-test-idle)
   (should (= 1 (length tabulated-list-entries)))
   (goto-char (point-min))
   (should (equal (alist-get 'target (ef-reader--selected)) "article"))
   (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "reading/blogs")))
     (ef-reader-save) (ef-rss-test-idle))
   (let ((rows (alist-get 'rows (ef-rss-test-state '((op . "favorites") (folder . "reading/blogs")) "favorites"))))
     (should (equal (alist-get 'target (car rows)) "article")))
   (let ((summary (selected-window)))
     (ef-reader-open) (ef-rss-test-idle)
     (should (eq major-mode 'ef-reader-article-mode))
     (should-not (eq summary (selected-window)))
     (should (> (car (window-edges)) (car (window-edges summary)))))
   (with-current-buffer "*Reader thread*"
     (should (string-match-p "RSS body version 1" (buffer-string)))
     (should (string-match-p "Save file.bin" (buffer-string)))
     (should ef-reader--complete))
   (with-current-buffer "*Reader*"
     (goto-char (point-min)) (ef-reader-delete))
   (ef-rss-test-idle)
   (should-not (alist-get 'rows (ef-rss-test-state `((op . "refresh") (source . ,source) (group . ,url)) "feed")))
   (ef-rss-test-control "update")
   (should (= 1 (length (alist-get 'rows (ef-rss-test-state `((op . "refresh") (source . ,source) (group . ,url)) "feed")))))
   (ef-rss-test-state '((op . "refresh-archives")) "archives-refreshed")
   (ef-probe-session-stop) (ef-reader-start)
   (ef-rss-test-control "offline")
   (with-current-buffer (get-buffer-create "*RSS saved*")
     (ef-reader-folder-mode) (setq ef-reader--folder "reading/blogs")
     (ef-reader--load-list))
   (ef-rss-test-idle)
   (with-current-buffer "*RSS saved*" (goto-char (point-min)) (ef-reader-open))
   (ef-rss-test-idle)
   (with-current-buffer "*Reader thread*"
     (should (string-match-p "RSS body version 2" (buffer-string)))
     (should ef-reader--archive))
   (let ((destination (expand-file-name "saved.bin" directory)))
     (ef-rss-test-state `((op . "attachment") (source . ,source) (id . "rss:one") (part . 0)
                         (destination . ,destination)) "saved")
     (with-temp-buffer
       (set-buffer-multibyte nil) (insert-file-contents-literally destination)
       (should (equal (buffer-string) (unibyte-string 82 83 83 0 97 116 116 97 99 104 109 101 110 116 255 10)))))))

(ert-deftest atom-browse-search-live-enclosure-without-subscription ()
  (ef-rss-test-session
   (setq url (concat ef-rss-test-base "/atom"))
   (ef-reader-rss url) (ef-rss-test-idle)
   (should (= 1 (length tabulated-list-entries)))
   (should-not (alist-get 'rows (ef-rss-test-state `((op . "feed") (source . ,source) (group . ,url)) "feed")))
   (ef-reader-rss-search "missing") (ef-rss-test-idle)
   (should-not tabulated-list-entries)
   (ef-reader-rss-search "PLAIN") (ef-rss-test-idle)
   (should (= 1 (length tabulated-list-entries)))
   (goto-char (point-min)) (ef-reader-open) (ef-rss-test-idle)
   (with-current-buffer "*Reader thread*"
     (should (string-match-p "Atom plain <b>text</b>" (buffer-string))))
   (let ((destination (expand-file-name "live.bin" directory)))
     (with-current-buffer "*Reader thread*"
       (goto-char (point-min)) (search-forward "Save file.bin")
       (cl-letf (((symbol-function 'read-file-name) (lambda (&rest _) destination)))
         (button-activate (button-at (1- (point))))))
     (ef-rss-test-idle)
     (should (= 16 (file-attribute-size (file-attributes destination)))))))

(ert-deftest rss-slow-http-is-cancellable-and-does-not-block-worker ()
  (ef-rss-test-session
   (let* ((slow (camulus-rss-submit `((op . "list") (url . ,(concat ef-rss-test-base "/slow")))))
          (other (ef-probe-submit 10 1 t nil 0)))
     (ef-rss-test-await other)
     (should-not (ef-rss-test-finished slow))
     (should (ef-probe-cancel slow))
     (ef-probe-await (lambda () (ef-rss-test-finished slow)) 3)
     (should (eq (nth 3 (ef-rss-test-finished slow)) 'cancelled)))))

(ert-deftest rss-unified-home-discovers-feeds-and-retains-cache-on-failure ()
  (ef-rss-test-session
   (let* ((atom (concat ef-rss-test-base "/atom"))
          (ef-reader-entries (append ef-reader-entries
                                     '(((name . "Unavailable") (source . "not-configured") (group . "inbox") (timeline . t))
                                       ((name . "Browse only") (source . "not-configured") (group . "browse"))))))
     (dolist (feed (list url atom))
       (ef-rss-test-await (camulus-subscription-submit
                          `((source . ,(concat "rss:" feed)) (target . ,feed) (setting . "subscribed")))))
     (camulus) (ef-rss-test-idle)
     (should ef-reader--home)
     (should (= 3 (length ef-reader-home--entries)))
     (should (= 2 (length tabulated-list-entries)))
     (should (= 1 (length ef-reader-home--errors)))
     (should (string-prefix-p "Home" (apply #'concat header-line-format)))
     (should-error (ef-reader-search "anything") :type 'user-error)
     (goto-char (point-min))
     (let* ((selected (ef-reader--selected)) (selected-source (alist-get 'source selected))
            (entry (ef-reader-home-row-entry selected)))
       (should entry)
       (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "home/saved")))
         (ef-reader-save) (ef-rss-test-idle))
       (should (= 1 (length (alist-get 'rows (ef-rss-test-state '((op . "favorites") (folder . "home/saved")) "favorites")))))
       (ef-reader-delete) (ef-rss-test-idle)
       (should (= 1 (length tabulated-list-entries)))
       (should (= 1 (length (alist-get 'rows (ef-rss-test-state
                     `((op . "feed") (source . ,selected-source) (group . ,(alist-get 'group entry))) "feed")))))
       (ef-reader-refresh) (ef-rss-test-idle)
       (should (= 1 (length tabulated-list-entries))))
     ;; Failed refresh leaves the visible cached row available for reading.
     (ef-rss-test-control "offline")
     (ef-reader-refresh) (ef-rss-test-idle)
     (should (= 1 (length tabulated-list-entries)))
     (should (>= (length ef-reader-home--errors) 2))
     ;; Removing a backend subscription removes membership on the next refresh.
     (dolist (feed (list url atom))
       (ef-rss-test-await (camulus-subscription-submit
                          `((source . ,(concat "rss:" feed)) (target . ,feed) (setting . "unsubscribed")))))
     (ef-reader-refresh) (ef-rss-test-idle)
     (should-not tabulated-list-entries))))

(unless (bound-and-true-p camulus-test-loading-helpers) (ert-run-tests-batch-and-exit))
