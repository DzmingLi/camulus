;;; package-startup.el --- Installed package activation and first command -*- lexical-binding: t; -*-
(require 'ert)
(require 'package)
(package-activate-all)
(ert-deftest camulus-installed-autoload-opens-native-home ()
  (should (commandp 'camulus))
  (should (autoloadp (symbol-function 'camulus)))
  (should (commandp 'camulus-subscriptions))
  (should (autoloadp (symbol-function 'camulus-subscriptions)))
  (should (autoloadp (symbol-function 'camulus-manage-subscriptions)))
  (should-not (featurep 'camulus_native))
  (should (autoloadp (symbol-function 'camulus-firefox-cookies-get)))
  (should (locate-library "webkit"))
  (should (locate-library "webkit-module"))
  (unwind-protect
      (progn
        (call-interactively 'camulus-subscriptions)
        (camulus-probe-await (lambda () (= 0 camulus-reader-subscriptions--pending)) 15)
        (should (eq major-mode 'camulus-subscriptions-mode))
        (call-interactively 'camulus)
        (camulus-probe-await (lambda () (and (null camulus-reader-home--jobs)
                                      (= 0 (hash-table-count camulus-reader--requests)))) 15)
        (should (featurep 'camulus_native))
        (should (eq major-mode 'camulus-reader-feed-mode))
        (should camulus-reader--home)
        (dolist (command '(camulus-mail-compose camulus-mail-drafts camulus-reader-discourse-like camulus-reddit-upvote camulus-manage-subscriptions))
          (should (commandp command)))
        (dolist (command '(camulus-zhihu-login camulus-zhihu-logout camulus-zhihu-login-code camulus-zhihu-login-cancel))
          (should-not (fboundp command)))
        (should-not (boundp 'camulus-zhihu-session-file))
        (should-not (fboundp 'camulus-csrin))
        (dolist (feature '(camulus-runtime host-process reader-config mail-workflow discourse-reader mail-demo reddit-demo effects-probe))
          (should-not (featurep feature))))
    (when (fboundp 'camulus-probe-session-stop) (camulus-probe-session-stop))))
(ert-run-tests-batch-and-exit)
