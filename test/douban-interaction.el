;;; douban-interaction.el --- Mock writes, no network or credentials -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'douban_probe)
(define-derived-mode camulus-reader-article-mode special-mode "Test article")
(defvar-local camulus-reader--source "douban")
(defvar-local camulus-reader--archive nil)
(defvar-local camulus-reader--messages nil)
(defvar-local camulus-reader--loaded nil)
(defun camulus-reader--render ())
(defun camulus-reader--selected () '((id . "topic:15/comment:3")))

(ert-deftest douban-like-confirms-current-floor-and-reports-failure ()
  (with-temp-buffer
    (camulus-reader-article-mode)
    (setq camulus-reader--messages (make-hash-table :test #'equal)
          camulus-reader--loaded (make-hash-table :test #'equal))
    (puthash "topic:15/comment:3" '((id . "topic:15/comment:3") (liked . nil)) camulus-reader--messages)
    (puthash "topic:15/comment:3" t camulus-reader--loaded)
    (camulus-douban-like)
    (should (equal (douban-test-request) '("topic:15/comment:3" t t)))
    ;; Request is sent immediately, without claiming success before the reply.
    (should-not (alist-get 'liked (gethash "topic:15/comment:3" camulus-reader--messages)))
    (should-error (camulus-douban-unlike))
    (douban-test-finish t)
    (should (alist-get 'liked (gethash "topic:15/comment:3" camulus-reader--messages)))
    (should (alist-get 'liked (douban-test-reconcile '((id . "topic:15/comment:3") (liked . nil)) 99)))
    (should-not (alist-get 'liked (douban-test-reconcile '((id . "topic:15/comment:3") (liked . nil)) 101)))
    (camulus-douban-unlike)
    (douban-test-finish nil)
    (should (alist-get 'liked (gethash "topic:15/comment:3" camulus-reader--messages)))
    ;; Failure clears the in-flight guard; a new explicit attempt is possible.
    (camulus-douban-unlike)
    (should (equal (douban-test-request) '("topic:15/comment:3" nil t)))
    (douban-test-finish t)
    (should-not (alist-get 'liked (gethash "topic:15/comment:3" camulus-reader--messages)))
    (setq camulus-reader--archive t)
    (should-error (camulus-douban-like))
    (setq camulus-reader--archive nil)
    (clrhash camulus-reader--loaded)
    (should-error (camulus-douban-like))))
(ert-run-tests-batch-and-exit)
