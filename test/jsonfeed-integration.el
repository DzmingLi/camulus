;;; jsonfeed-integration.el --- Native JSON Feed workflow -*- lexical-binding: t; -*-
(defvar camulus-test-loading-helpers t)
(load (expand-file-name "rss-integration.el" (file-name-directory load-file-name)) nil t)
(ert-deftest jsonfeed-native-pagination-subscription-and-archive ()
  (camulus-rss-test-session
   (let* ((feed (concat camulus-rss-test-base "/json")) (source (concat "jsonfeed:" feed)))
     (camulus-jsonfeed feed) (camulus-rss-test-idle)
     (should (= 1 (length tabulated-list-entries)))
     (should camulus-reader--cursor)
     (camulus-reader-more) (camulus-rss-test-idle)
     (should (= 2 (length tabulated-list-entries)))
     (should-not camulus-reader--cursor)
     (goto-char (point-min))
     (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "subscribed")))
       (camulus-reader-subscription) (camulus-rss-test-idle))
     (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "json/saved")))
       (camulus-reader-save) (camulus-rss-test-idle))
     (camulus-reader-open) (camulus-rss-test-idle)
     (should (string-match-p "JSON body version 1" (buffer-string)))
     (should (string-match-p "Save file.bin" (buffer-string)))
     (camulus) (camulus-rss-test-idle)
     (should (cl-find source camulus-reader-home--entries :key (lambda (e) (alist-get 'source e)) :test #'equal))
     (should (= 1 (length tabulated-list-entries)))
     (camulus-rss-test-control "offline")
     (let ((rows (alist-get 'rows (camulus-rss-test-state '((op . "favorites") (folder . "json/saved")) "favorites"))))
       (should (= 1 (length rows)))
       (let ((id (alist-get 'id (car rows))) (destination (expand-file-name "json.bin" directory)))
         (camulus-rss-test-state `((op . "attachment") (source . ,source) (id . ,id) (part . 0) (destination . ,destination)) "saved")
         (should (= 16 (file-attribute-size (file-attributes destination)))))))))
(ert-run-tests-batch-and-exit "^jsonfeed-")
