;;; github-integration.el --- GitHub and Forge navigation -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'camulus)
;; Protocol-boundary fixtures: the regular test editor need not install Forge.
(provide 'forge)
(provide 'ghub)

(defconst camulus-github-test-row
  '((source . "github") (id . "PR_fixture")
    (url . "https://github.com/owner/repo/pull/42#discussion_r1")))

(ert-deftest github-forge-opens-the-exact-topic-without-comment-fragment ()
  (let ((features (cons 'forge features)) visited)
    (with-temp-buffer
      (cl-letf (((symbol-function 'camulus-reader--selected) (lambda () camulus-github-test-row))
                ((symbol-function 'forge-visit-topic-from-url) (lambda (url) (setq visited url))))
        (camulus-github-forge-topic)
        (should (equal visited "https://github.com/owner/repo/pull/42"))))))

(ert-deftest github-article-navigation-uses-current-message ()
  (let ((features (cons 'forge features)) visited)
    (with-temp-buffer
      (camulus-reader-article-mode)
      (setq-local camulus-reader--source "github")
      (puthash "comment" '((id . "comment") (thread_id . "PR_fixture")
                           (url . "https://github.com/owner/repo/pull/42#discussion_r9"))
               camulus-reader--messages)
      (cl-letf (((symbol-function 'camulus-reader--selected)
                 (lambda () '((source . "github") (id . "comment") (target . "article"))))
                ((symbol-function 'forge-visit-topic-from-url) (lambda (url) (setq visited url))))
        (camulus-github-forge-topic)
        (should (equal visited "https://github.com/owner/repo/pull/42"))))))

(ert-deftest github-magit-reuses-forge-worktree-without-fetch-or-registration ()
  (let ((features (cons 'forge features)) visited)
    (with-temp-buffer
      (cl-letf (((symbol-function 'camulus-reader--selected) (lambda () camulus-github-test-row))
                ((symbol-function 'forge-get-repository)
                 (lambda (identity remote demand)
                   (should (equal identity '("github.com" "owner" "repo")))
                   (should-not remote) (should (eq demand :known?)) 'repository))
                ((symbol-function 'forge-get-worktree)
                 (lambda (repo) (should (eq repo 'repository)) "/fixture/worktree/"))
                ((symbol-function 'magit-status) (lambda (directory) (setq visited directory)))
                ((symbol-function 'forge-add-repository) (lambda (&rest _) (ert-fail "Unexpected registration")))
                ((symbol-function 'forge-pull) (lambda (&rest _) (ert-fail "Unexpected fetch"))))
        (camulus-github-magit)
        (should (equal visited "/fixture/worktree/"))))))

(ert-deftest github-repository-opens-from-local-forge-context ()
  (let ((features (cons 'forge features)) entry)
    (with-temp-buffer
      (cl-letf (((symbol-function 'forge-get-repository)
                 (lambda (demand) (should (eq demand :stub?))
                   '((forge . "github.com") (owner . "owner") (name . "repo"))))
                ((symbol-function 'eieio-oref) (lambda (object slot) (alist-get slot object)))
                ((symbol-function 'forge-get-worktree) (lambda (_) "/fixture/worktree/"))
                ((symbol-function 'completing-read) (lambda (&rest _) "discussions"))
                ((symbol-function 'camulus-reader-browse-entry) (lambda (e) (setq entry e))))
        (camulus-github-repository)
        (should (equal (alist-get 'source entry) "github"))
        (should (equal (alist-get 'group entry) "owner/repo/discussions"))
        (should (equal default-directory "/fixture/worktree/"))))))

(ert-deftest github-missing-worktree-does-not-clone-or-open-unrelated-code ()
  (let ((features (cons 'forge features)))
    (with-temp-buffer
      (cl-letf (((symbol-function 'camulus-reader--selected) (lambda () camulus-github-test-row))
                ((symbol-function 'forge-get-repository) (lambda (&rest _) nil))
                ((symbol-function 'magit-status) (lambda (&rest _) (ert-fail "Unrelated worktree"))))
        (should-error (camulus-github-magit) :type 'user-error)))))

(ert-deftest github-review-code-opens-exact-commit-and-line ()
  (let ((features (cons 'forge features)) visited)
    (with-temp-buffer
      (setq-local camulus-github--review-data
                  '((pr . ((url . "https://github.com/owner/repo/pull/42")
                           (headRefOid . "head-commit") (baseRefOid . "base-commit")))))
      (insert (propertize "changed line" 'camulus-github-location
                          '((path . "src/example.ml") (line . 3) (side . "RIGHT"))))
      (goto-char (point-min))
      (cl-letf (((symbol-function 'forge-get-repository) (lambda (&rest _) 'repository))
                ((symbol-function 'forge-get-worktree) (lambda (_) "/fixture/worktree/"))
                ((symbol-function 'file-in-directory-p) (lambda (&rest _) t))
                ((symbol-function 'magit-find-file)
                 (lambda (rev file)
                   (setq visited (list rev file default-directory))
                   (erase-buffer) (insert "one\ntwo\nthree\nfour\n"))))
        (camulus-github-review-find-file)
        (should (equal visited '("head-commit" "src/example.ml" "/fixture/worktree/")))
        (should (= 3 (line-number-at-pos)))))))

(ert-deftest github-start-reuses-forge-token-without-creating-credentials ()
  (let ((features (cons 'ghub features)) (camulus-github-auth-user nil)
        (camulus-groups nil) (camulus-discourse-sites nil) (camulus-mail-accounts nil)
        (camulus-reddit-username nil) called)
    (cl-letf (((symbol-function 'ghub--username)
               (lambda (host forge) (should (equal host "api.github.com"))
                 (should (eq forge 'github)) "fixture-user"))
              ((symbol-function 'ghub--token)
               (lambda (host user package nocreate)
                 (should (equal host "api.github.com")) (should (equal user "fixture-user"))
                 (should (eq package 'forge)) (should nocreate)
                 (setq called t) "fixture-token"))
              ((symbol-function 'camulus-probe-session-start) #'ignore))
      (camulus-reader-start)
      (should called))))

(ert-run-tests-batch-and-exit)
