;;; github-forge.el --- Actual Forge database/worktree contract -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'forge)
(require 'camulus)

(ert-deftest github-real-forge-worktree-and-cached-topic-are-reused ()
  (let* ((directory (make-temp-file "camulus-forge-worktree" t))
         (default-directory (file-name-as-directory directory))
         (forge-database-file (expand-file-name "forge.sqlite" directory))
         ;; This is a separate test editor and an isolated, disposable Forge DB.
         (owner "camulus-fixture") (name "local-repository")
         repo issue visited)
    (unwind-protect
        (progn
          (should (zerop (call-process "git" nil nil nil "init" "-q")))
          (should (zerop (call-process "git" nil nil nil "remote" "add" "origin"
                                     (format "git@github.com:%s/%s.git" owner name))))
          (setq repo (forge-get-repository (list "github.com" owner name) nil :stub))
          (closql-insert (forge-db) repo)
          (oset repo condition :tracked)
          (should (equal (file-truename default-directory)
                         (file-truename (forge-get-worktree repo))))
          (setq issue (make-instance 'forge-issue :id (forge--object-id 'forge-issue repo 42)
                                     :repository (oref repo id) :number 42 :title "Fixture"))
          (closql-insert (forge-db) issue)
          (let ((row `((source . "github") (id . "fixture-issue-id")
                       (url . ,(format "https://github.com/%s/%s/issues/42#issuecomment-1" owner name))))
                (default-directory temporary-file-directory))
            (cl-letf (((symbol-function 'camulus-reader--selected) (lambda () row))
                      ((symbol-function 'magit-status) (lambda (dir) (setq visited dir)))
                      ((symbol-function 'forge--pull-topic) (lambda (&rest _) (ert-fail "Unexpected network request")))
                      ((symbol-function 'forge-topic-setup-buffer) (lambda (topic) (setq visited topic))))
              (camulus-github-magit)
              (should (equal (directory-file-name (file-truename visited)) (file-truename directory)))
              (camulus-github-forge-topic)
              (should (equal (oref visited id) (oref issue id)))))
          (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "issues"))
                    ((symbol-function 'camulus-reader-browse-entry) (lambda (entry) (setq visited entry))))
            (camulus-github-repository)
            (should (equal (alist-get 'group visited) (format "%s/%s/issues" owner name)))))
      (when (forge-db t) (emacsql-close (forge-db)))
      (delete-directory directory t))))
(ert-run-tests-batch-and-exit)
