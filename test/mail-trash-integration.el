;;; mail-trash-integration.el --- Trash feedback and duplicate protection -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'camulus)

(defmacro camulus-mail-with-trash-fixture (&rest body)
  `(with-temp-buffer
     (camulus-reader-feed-mode)
     (setq-local camulus-reader--entry '((source . "maildir:/fixture") (group . "/work/Inbox")))
     (let ((row (copy-tree '((source . "maildir:/fixture") (id . "mail:fixture@example.test")
                  (conversation_id . "mail:root@example.test"))))
           (requests nil) (next-id 0) messages)
       (setq-local camulus-reader--rows (make-hash-table :test #'equal))
       (puthash "fixture-row" row camulus-reader--rows)
       (cl-letf (((symbol-function 'tabulated-list-get-id) (lambda (&rest _) "fixture-row"))
                 ((symbol-function 'camulus-mail-submit)
                  (lambda (request) (push request requests) (cl-incf next-id)))
                 ((symbol-function 'message)
                  (lambda (format &rest args) (push (apply #'format format args) messages))))
         ,@body))))

(ert-deftest mail-trash-submits-once-and-reports-lock-wait-without-finishing ()
  (camulus-mail-with-trash-fixture
   (camulus-reader-delete)
   (should (= 1 (length requests)))
   (should (string-match-p "Queued move to Trash" (car messages)))
   (camulus-mail--action-event '(mail 1 ((kind . "progress") (message . "Waiting for mail access"))))
   (should (equal (car messages) "Waiting for mail access"))
   (camulus-reader-delete)
   (should (= 1 (length requests)))
   (should (string-match-p "already queued" (car messages)))
   ;; Another message in the same conversation is the same pending operation.
   (setf (alist-get 'id row) "mail:another@example.test")
   (camulus-reader-delete)
   (should (= 1 (length requests)))
   (camulus-mail--action-event '(finished 1 failed "mu write lock"))
   (should (string-match-p "mu write lock" (car messages)))
   (camulus-reader-delete)
   (should (= 2 (length requests)))
   (camulus-mail--action-event '(finished 2 cancelled "Cancelled"))))

(ert-deftest mail-trash-result-waits-for-terminal-event-and-clears-pending-on-error ()
  (camulus-mail-with-trash-fixture
   (camulus-reader-delete)
   (camulus-mail--action-event '(mail 1 ((kind . "trashed") (destination . "/work/Trash")
                                       (moved . ("mail:fixture@example.test")) (failed . 0))))
   (camulus-reader-delete)
   (should (= 1 (length requests)))
   (camulus-mail--action-event '(finished 1 failed "Cancelled before confirmation"))
   (should (string-match-p "Cancelled before confirmation" (car messages)))
   (camulus-reader-delete)
   (should (= 2 (length requests)))
   (camulus-mail--action-event '(finished 2 completed ""))
   (should (string-match-p "No Trash result received" (car messages)))))

(ert-deftest mail-trash-submit-failure-can-be-retried ()
  (camulus-mail-with-trash-fixture
   (cl-letf (((symbol-function 'camulus-mail-submit) (lambda (_) (error "Worker busy"))))
     (should-error (camulus-reader-delete)))
   (camulus-reader-delete)
   (should (= 1 (length requests)))
   (camulus-mail--action-event '(finished 1 failed "Fixture cleanup"))))
(ert-run-tests-batch-and-exit)
