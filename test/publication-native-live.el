;;; publication-native-live.el --- Explicit read-only smoke check -*- lexical-binding: t; -*-
(require 'camulus)
(setq camulus-probe-record-events t)
(defun camulus-publication-live-finished (id)
  (cl-find-if (lambda (e) (and (eq (car e) 'finished) (= (cadr e) id))) camulus-probe--events))
(defun camulus-publication-live-await (id)
  (camulus-probe-await (lambda () (camulus-publication-live-finished id)) 90)
  (let ((event (camulus-publication-live-finished id)))
    (unless (eq (nth 3 event) 'completed) (error "Native request failed: %s" (nth 4 event)))))
(let* ((directory (make-temp-file "publication-native-live" t))
       (camulus-state-file (expand-file-name "state.sqlite" directory))
       (camulus-reader-rss-subscriptions-file (expand-file-name "rss.json" directory))
       (camulus-reader-config-file (or (getenv "EF_ENTRIES_CONFIG") (error "EF_ENTRIES_CONFIG required")))
       (sources (if (getenv "EF_LIVE_SOURCES") (split-string (getenv "EF_LIVE_SOURCES") "," t)
                  '("atlantic" "janestreet" "zhihu" "douban" "netease" "public-inbox" "blogger" "gcores")))
       (errors 0))
  (unwind-protect
      (progn
        (camulus-reader-start)
        (dolist (source sources)
          (condition-case problem
              (let* ((entry (cl-find-if (lambda (e) (and (equal source (alist-get 'source e))
                                                       (not (string-prefix-p "replies." (alist-get 'group e))))) camulus-groups))
                     (group (alist-get 'group entry))
                     (id (camulus-state-submit `((op . "refresh") (source . ,source) (group . ,group)))))
                (camulus-publication-live-await id)
                (let* ((events (cl-remove-if-not (lambda (e) (and (eq (car e) 'content-state) (= id (cadr e)))) camulus-probe--events))
                       (data (cl-find-if (lambda (d) (equal (alist-get 'kind d) "feed"))
                                         (mapcar (lambda (e) (nth 3 e)) events)))
                       (rows (alist-get 'rows data)))
                  (unless rows (error "No native list rows"))
                  (let ((buffer (get-buffer-create "*Publication native check*")))
                    (with-current-buffer buffer
                      (camulus-reader-feed-mode)
                      (setq camulus-reader--entry entry)
                      (camulus-reader--set-rows rows)
                      (goto-char (point-min))
                      (camulus-reader-open))
                    (with-current-buffer "*Reader thread*"
                      (camulus-publication-live-await camulus-reader--active)
                      (unless (> (hash-table-count camulus-reader--loaded) 0) (error "No body delivered to reading buffer"))
                      (unless camulus-reader--complete (error "Reading view remained incomplete"))
                      (princ (format "PASS Ecaml/UI %s: %d rows, %d loaded messages\n" source (length rows) (hash-table-count camulus-reader--loaded)))))))
            (error (cl-incf errors) (princ (format "FAIL Ecaml/UI %s: %s\n" source (error-message-string problem)))))))
    (dolist (buffer (buffer-list))
      (with-current-buffer buffer (when (derived-mode-p 'camulus-reader-article-mode 'camulus-reader-feed-mode) (kill-buffer buffer))))
    (camulus-probe-session-stop)
    (delete-directory directory t))
  (when (> errors 0) (kill-emacs 1)))
