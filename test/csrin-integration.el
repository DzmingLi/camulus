;;; csrin-integration.el --- CS.RIN.RU native workflows -*- lexical-binding: t; -*-
(require 'ert)
(require 'camulus)
(require 'url)
(setq ef-probe-record-events t)
(defvar csrin-base (or (getenv "CSRIN_FIXTURE") (error "CSRIN_FIXTURE required")))
(defun csrin-finished (id)
  (cl-find-if (lambda (e) (and (eq (car e) 'finished) (= (cadr e) id))) ef-probe--events))
(defun csrin-state (request kind)
  (let ((id (camulus-state-submit request)))
    (ef-probe-await (lambda () (csrin-finished id)) 15)
    (should (eq (nth 3 (csrin-finished id)) 'completed))
    (cl-find kind (mapcar (lambda (e) (nth 3 e))
                         (cl-remove-if-not (lambda (e) (and (eq (car e) 'content-state) (= (cadr e) id))) ef-probe--events))
             :key (lambda (d) (alist-get 'kind d)) :test #'equal)))
(defun csrin-idle ()
  (ef-probe-await (lambda () (and (= 0 (hash-table-count ef-reader--requests))
                                (= 0 (hash-table-count ef-reader--loads)))) 15))
(defmacro csrin-session (&rest body)
  `(let* ((directory (make-temp-file "csrin-reader" t))
          (process-environment (cons (concat "XDG_STATE_HOME=" directory) process-environment))
          (ef-reader-config-file (expand-file-name "config.json" directory))
          (ef-reader-groups-file (expand-file-name "groups.json" directory))
          (camulus-group-subscriptions-file (expand-file-name "group-subscriptions.json" directory))
          (ef-reader-state-file (expand-file-name "state.sqlite" directory))
          (ef-reader-rss-subscriptions-file (expand-file-name "rss.json" directory))
          (camulus-jsonfeed-subscriptions-file (expand-file-name "jsonfeed.json" directory))
          (camulus-csrin-site (concat csrin-base "/forum/"))
          (ef-reader-firefox-profile nil) (ef-mail-sender nil) (ef-reddit-username nil)
          (ef-reader-entries nil))
     (ef-reader-start)
     (unwind-protect (save-window-excursion ,@body)
       (dolist (buffer (buffer-list))
         (with-current-buffer buffer
           (when (or (derived-mode-p 'ef-reader-feed-mode 'ef-reader-article-mode 'ef-reader-folder-mode)
                     (and buffer-file-name (string-prefix-p directory buffer-file-name)))
             (set-buffer-modified-p nil) (kill-buffer buffer))))
       (ef-probe-session-stop) (ef-content-state-configure "")
       (delete-directory directory t))))
(defun csrin-login ()
  (cl-letf (((symbol-function 'auth-source-search)
             (lambda (&rest _) (list (list :user "fixture-user" :secret (lambda () "fixture-password"))))))
    (camulus-csrin-login))
  (ef-probe-await (lambda () (cl-find-if (lambda (e) (and (eq (car e) 'content-state)
                   (equal (alist-get 'kind (nth 3 e)) "csrin-login"))) ef-probe--events))))
(defun csrin-post-count ()
  (let ((url-proxy-services nil))
    (with-current-buffer (url-retrieve-synchronously (concat csrin-base "/control/count") t t 5)
      (unwind-protect (progn (goto-char (point-min)) (re-search-forward "\r?\n\r?\n")
                            (string-to-number (buffer-substring (point) (point-max))))
        (kill-buffer)))))
(ert-deftest csrin-read-complete-tree-archive-and-offline ()
  (csrin-session
   (camulus-csrin "forum.14") (csrin-idle)
   (should (= 1 (length tabulated-list-entries)))
   (goto-char (point-min))
   (let ((summary (selected-window)))
     (ef-reader-open) (csrin-idle)
     (should (eq major-mode 'ef-reader-article-mode))
     (should-not (eq summary (selected-window))))
   (should ef-reader--complete)
   (should (string-match-p "Full post 100" (buffer-string)))
   (should (string-match-p "Full post 101" (buffer-string)))
   (should (= 2 (hash-table-count ef-reader--messages)))
   (with-current-buffer "*Reader*"
     (goto-char (point-min))
     (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "forums/csrin")))
       (ef-reader-save) (csrin-idle)))
   (csrin-idle)
   (let* ((data (csrin-state '((op . "archive") (source . "csrin") (id . "topic:12/post:101") (target . "thread")) "archive"))
          (articles (alist-get 'articles data)))
     (should (= 2 (length articles)))
     (should (= 2 (length (alist-get 'attachments (car articles)))))
     (ef-probe-session-stop)
     (setq camulus-csrin-site "http://127.0.0.1:1/forum/")
     (ef-reader-start)
     (should (= 1 (length (alist-get 'rows (csrin-state '((op . "favorites") (folder . "forums/csrin")) "favorites")))))
     (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) (ert-fail "Folder browser prompted"))))
       (ef-reader-folders) (csrin-idle))
     (should (eq major-mode 'ef-reader-folders-mode))
     (goto-char (point-min)) (search-forward "csrin")
     (button-activate (button-at (1- (point)))) (csrin-idle)
     (set-buffer (window-buffer (selected-window)))
     (goto-char (point-min)) (ef-reader-open) (csrin-idle)
     (should (string-match-p "Full post 101" (buffer-string))))))
(ert-deftest csrin-compose-autosave-send-and-uncertain-keeps-draft ()
  (csrin-session
   (csrin-login)
   (camulus-csrin "forum.14") (csrin-idle) (goto-char (point-min))
   (ef-reader-open) (csrin-idle)
   (let ((summary (get-buffer-window "*Reader*"))
         (reader (selected-window)))
     (camulus-csrin-reply)
     (ef-probe-await (lambda () (with-current-buffer (window-buffer (selected-window)) (derived-mode-p 'message-mode))))
     (set-buffer (window-buffer (selected-window)))
     (should (eq (selected-window) summary))
     (should (eq (window-buffer reader) (get-buffer "*Reader thread*"))))
   (message-goto-body) (insert "[b]Reply[/b]")
   (ef-probe-await (lambda () (not (buffer-modified-p))) 3)
   (let ((file buffer-file-name) (draft (current-buffer)))
     (should (= #o600 (logand #o777 (file-modes file))))
     (camulus-csrin-send)
     (ef-probe-await (lambda () (not (buffer-live-p draft))) 10)
     (should-not (file-exists-p file)))
   (select-window (get-buffer-window "*Reader thread*"))
   (camulus-csrin-reply)
   (ef-probe-await (lambda () (with-current-buffer (window-buffer (selected-window)) (derived-mode-p 'message-mode))))
   (set-buffer (window-buffer (selected-window)))
   (message-goto-body) (insert "uncertain")
   (let ((file buffer-file-name) (before (csrin-post-count)))
     (camulus-csrin-send)
     (ef-probe-await (lambda () (not camulus-csrin--sending)) 10)
     (should (file-exists-p file))
     (should-not buffer-read-only)
     (should (string-match-p "unconfirmed" header-line-format))
     (should (= (csrin-post-count) (1+ before)))
     (camulus-csrin-close-draft)
     (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) file)))
       (camulus-csrin-drafts))
     (should (string-match-p "Previous send" header-line-format))
     (should (equal (message-fetch-field "X-Camulus-Delivery") "submitting")))))
(ert-run-tests-batch-and-exit)
