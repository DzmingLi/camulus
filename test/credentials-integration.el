;;; credentials-integration.el --- Owner-thread credential lookup -*- lexical-binding: t -*-
(require 'ert)
(require 'cl-lib)
(require 'auth-source)
(require 'credentials_probe)
(ert-deftest credentials-resolve-lazy-secrets-with-scoped-sources ()
  (let ((auth-sources '("global.authinfo")) (resolved 0))
    (cl-letf (((symbol-function 'auth-source-search)
               (lambda (&rest args)
                 (should (equal auth-sources '("fixture.authinfo" "global.authinfo")))
                 (should (equal (plist-get args :host) "fixture.test"))
                 (should (equal (plist-get args :port) "fixture-api"))
                 (should (equal (plist-get args :user) "fixture-user"))
                 (should (= (plist-get args :max) 1))
                 (list (list :user "fixture-user" :secret (lambda () (cl-incf resolved) "fixture-secret"))))))
      (camulus-test-credential)
      (should (equal camulus-test-credential-result '("fixture-user" "fixture-secret")))
      (should (= resolved 1)))
    (should (equal auth-sources '("global.authinfo")))))
(ert-deftest credentials-restore-sources-after-lookup-error ()
  (let ((auth-sources '("global.authinfo")))
    (cl-letf (((symbol-function 'auth-source-search) (lambda (&rest _) (error "Fixture lookup failed"))))
      (should-error (camulus-test-credential)))
    (should (equal auth-sources '("global.authinfo")))))
(ert-deftest credentials-missing-entry-is-optional ()
  (cl-letf (((symbol-function 'auth-source-search) (lambda (&rest _) nil)))
    (camulus-test-credential)
    (should-not camulus-test-credential-result)))
(ert-run-tests-batch-and-exit)
