;;; gnus-inventory.el --- Read saved Gnus metadata without evaluating it -*- lexical-binding: t; -*-
(require 'cl-lib)
(require 'json)
(require 'subr-x)
(defun ef-gnus-read-forms (file function)
  (when (file-readable-p file)
    (with-temp-buffer
      (insert-file-contents file)
      (emacs-lisp-mode)
      (goto-char (point-min))
      (while (progn (forward-comment (point-max)) (not (eobp)))
        (funcall function (read (current-buffer)))))))
(defun ef-gnus-unquote (form)
  (unless (and (eq (car-safe form) 'quote) (= (length form) 2))
    (error "Expected quoted saved data"))
  (cadr form))
(defun ef-gnus-inventory (newsrc news)
  (let ((groups nil) (rss nil))
    (ef-gnus-read-forms newsrc
      (lambda (form)
        (when (and (eq (car-safe form) 'setq) (eq (cadr form) 'gnus-newsrc-alist))
          (setq groups (ef-gnus-unquote (nth 2 form))))))
    (unless groups (error "No gnus-newsrc-alist in %s" newsrc))
    (ef-gnus-read-forms (concat newsrc "-dribble")
      (lambda (form)
        (pcase (car-safe form)
          ('gnus-group-set-info
           (let ((entry (ef-gnus-unquote (cadr form))))
             (when (and (listp entry) (stringp (car entry)))
               (setf (alist-get (car entry) groups nil nil #'equal) (cdr entry)))))
          ('gnus-group-change-level
           (when (and (stringp (nth 1 form)) (integerp (nth 2 form)))
             (when-let* ((entry (assoc (nth 1 form) groups))) (setcar (cdr entry) (nth 2 form))))))))
    (ef-gnus-read-forms (expand-file-name "rss/nnrss.el" news)
      (lambda (form)
        (when (and (eq (car-safe form) 'setq) (eq (cadr form) 'nnrss-group-alist))
          (setq rss (ef-gnus-unquote (nth 2 form))))))
    `((groups . ,(vconcat
                  (mapcar
                   (lambda (g)
                     (let* ((method (nth 4 g))
                            (backend (if (listp method) (symbol-name (car method))
                                       (car (split-string (or method (car g)) "[:+]"))))
                            (server (if (listp method) (nth 1 method)
                                      (and (stringp method) (string-match ":\\(.*\\)" method) (match-string 1 method)))))
                       `((group . ,(car g)) (level . ,(nth 1 g)) (backend . ,backend)
                         (server . ,server)
                         (address . ,(and (listp method) (cadr (assq 'nndiscourse-address (nthcdr 2 method)))))
                         (comment . ,(cdr (assq 'comment (nth 5 g))))))) groups)))
      (rss . ,(vconcat (mapcar (lambda (r) `((group . ,(car r)) (url . ,(nth 1 r)))) rss))))))
(when (getenv "EF_GNUS_INVENTORY")
  (princ (json-encode (ef-gnus-inventory (getenv "EF_GNUS_NEWSRC") (getenv "EF_GNUS_NEWS")))))
